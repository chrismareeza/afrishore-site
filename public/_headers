# Cloudflare Pages custom response headers.
# Syntax: <path>\n  <Header>: <Value>
#
# /.well-known/traffic-advice is Chrome's Private Prefetch Proxy probe.
# Spec wants the response served as application/trafficadvice+json so
# Chrome's parser accepts it cleanly without the fallback path.

/.well-known/traffic-advice
  Content-Type: application/trafficadvice+json
