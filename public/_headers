# Cloudflare Pages custom response headers.
# Syntax: <path>\n  <Header>: <Value>
#
# /.well-known/traffic-advice is Chrome's Private Prefetch Proxy probe.
# Spec wants the response served as application/trafficadvice+json so
# Chrome's parser accepts it cleanly without the fallback path.

/.well-known/traffic-advice
  Content-Type: application/trafficadvice+json

# Astro emits all bundled JS/CSS/fonts under /_astro/ with a content hash
# in the filename (e.g. Footer.CTCBBcHC.css). The filename changes on every
# deploy whenever the content changes, so it is safe to cache them for a
# year and mark them immutable — browsers and CDNs can skip revalidation
# entirely. Clears the PSI "Use efficient cache lifetimes" warning.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Same logic for fingerprinted images Astro generates (if any are added in
# future via the Image integration). Static images served from /public are
# left under the default policy because their filenames are not hashed.
/_image/*
  Cache-Control: public, max-age=31536000, immutable
