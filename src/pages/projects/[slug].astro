---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import { projects, allProjects, type Project } from "../../data/projects";
import { linkifyPorts } from "../../lib/portLinks";

export function getStaticPaths() {
  return projects
    .filter((p) => p.published)
    .map((p) => ({
      params: { slug: p.slug },
      props: { project: p },
    }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;

const siteUrl = "https://www.afrishore.co";
const projectUrl = `${siteUrl}/projects/${project.slug}`;

// SEO
const metaTitle = `${project.title} · Afrishore Maritime Logistics`;
const metaDescription = project.summary;

// Service type labels for human-readable badges
const serviceLabels: Record<string, string> = {
  "ship-rig-agency": "Vessel & Rig Agency",
  "supply-base": "Supply Base",
  "integrated-logistics": "Integrated Logistics",
  "crew-visa": "Crew & Visa",
  "subsea-services": "Subsea Services",
};

// Related projects (3 most recent others)
const related = allProjects.filter((p) => p.slug !== project.slug).slice(0, 3);

// Split outcome into paragraphs (separated by blank lines)
const outcomeParagraphs = project.outcome
  ? project.outcome.split("\n\n").filter((p) => p.trim())
  : [];

// Asset label: exact when known ("Rig"/"Vessel"), else the generic hedge.
const assetLabel =
  project.assetType === "rig"
    ? "Rig"
    : project.assetType === "vessel"
      ? "Vessel"
      : "Vessel / Rig";

// Gradient placeholder for missing images
const placeholderBg = "linear-gradient(135deg, #1a1410 0%, #ED7014 50%, #FDE64B 100%)";

// Each optimised JPEG ships with a sibling .webp (image pipeline).
const webp = (p: string) => p.replace(/\.jpe?g$/i, ".webp");

// Derive a stable ISO date from the year field ("2024", "2024–2025", "2018–2019")
// so Article schema gets datePublished/dateModified.
const yearParts = project.year.split(/[–-]/).map((s) => s.trim());
const startYear = yearParts[0] || "2010";
const endYear = yearParts[yearParts.length - 1] || startYear;
// Full ISO 8601 with SAST (UTC+02:00) timezone — Google Rich Results
// flags bare dates as "missing timezone / invalid datetime" (non-critical).
const publishedTime = `${startYear}-01-01T00:00:00+02:00`;
const modifiedTime = `${endYear}-12-31T23:59:59+02:00`;

// Article schema for the case study (with image when available).
const heroAbsolute = project.heroImage
  ? new URL(project.heroImage, siteUrl).toString()
  : new URL("/og-image.jpg", siteUrl).toString();

// Hero image alt: prefer a hand-written one when supplied, otherwise
// generate from title/vessel/port/year. Reused for og:image:alt so
// social-share previews describe the actual image.
const heroAlt =
  project.heroAlt ||
  `${project.title}${project.vessel ? ` — ${project.vessel}` : ""} at ${project.port} (${project.year})`;

// ── Entity strengthening ──────────────────────────────────────────────
// Every case study that features the same vessel emits the same stable
// @id, so Google merges the references and Afrishore becomes the
// consistent provider in the rig's knowledge-graph neighbourhood.
const vesselSlug = (s: string) =>
  s.toLowerCase().normalize("NFKD").replace(/[^\w]+/g, "-").replace(/^-|-$/g, "");
const vesselId = project.vessel ? `${siteUrl}/#vessel-${vesselSlug(project.vessel)}` : null;

// Port → Place. When the port matches one of the four LocalBusiness
// offices declared in BaseLayout, reference the LocalBusiness @id;
// otherwise emit a plain Place.
const officeIdMap: Record<string, string> = {
  "Walvis Bay": `${siteUrl}/#walvis-bay`,
  "Cape Town": `${siteUrl}/#cape-town`,
  "Mossel Bay": `${siteUrl}/#mossel-bay`,
  "Durban": `${siteUrl}/#durban`,
};
// Split on "/" or " via " so an air route ("Dar es Salaam via Johannesburg")
// resolves to its component places for schema purposes.
const portList = project.port.split(/\s*(?:\/|via)\s+/i).map((p) => p.trim()).filter(Boolean);
// Bare place names for non-port projects (e.g. air-charter); the seaport
// prefix is only added when this case study is in fact at a seaport.
const isSeaPort = !project.locationLabel || project.locationLabel === "Port";
const portPlaces = portList.map((p) =>
  officeIdMap[p] ? { "@id": officeIdMap[p] } : { "@type": "Place", "name": isSeaPort ? `Port of ${p}` : p }
);
const contentLocation = portPlaces.length === 1 ? portPlaces[0] : portPlaces;

// Port-hub linking — turn the port label on the case study into a link to the
// matching /ports/<slug> hub so every project mentioning a port passes equity
// to that hub page. Segments that don't match a known port (e.g. "Port of
// Réunion" or air-charter routes) render as plain text.
const PORT_HUB_SLUGS: Record<string, string> = {
  "walvis bay": "walvis-bay",
  "lüderitz": "luderitz",
  "luderitz": "luderitz",
  "cape town": "cape-town",
  "saldanha": "saldanha",
  "saldanha bay": "saldanha",
  "mossel bay": "mossel-bay",
  "durban": "durban",
};
const portSegments = isSeaPort
  ? project.port.split(/\s*[\/·]\s*/).map((seg) => {
      const cleaned = seg
        .toLowerCase()
        .replace(/^port of\s+/, "")
        .replace(/,.*$/, "")
        .trim();
      return { text: seg, slug: PORT_HUB_SLUGS[cleaned] || null };
    })
  : [{ text: project.port, slug: null as string | null }];

// Service category — link the case study to the abstract Service node
// already declared in BaseLayout's @graph (when one matches).
const serviceCategoryIdMap: Record<string, string> = {
  "ship-rig-agency": `${siteUrl}/#service-ship-rig-agency`,
  "supply-base": `${siteUrl}/#service-supply-base`,
  "integrated-logistics": `${siteUrl}/#service-integrated-logistics`,
  "crew-visa": `${siteUrl}/#service-crew-visa`,
};
const primaryServiceTypeKey = project.serviceTypes[0];
const primaryServiceCategoryId = serviceCategoryIdMap[primaryServiceTypeKey] || null;

const temporalCoverage = `${startYear}-01-01/${endYear}-12-31`;

const articleSchema = {
  "@type": "Article",
  "@id": `${projectUrl}#article`,
  "headline": project.title,
  "name": project.title,
  "description": project.summary,
  "image": [heroAbsolute],
  "datePublished": publishedTime,
  "dateModified": modifiedTime,
  "temporalCoverage": temporalCoverage,
  "author": { "@id": `${siteUrl}/#organization` },
  "publisher": { "@id": `${siteUrl}/#organization` },
  "mainEntityOfPage": { "@type": "WebPage", "@id": projectUrl },
  "articleSection": "Case Study",
  "contentLocation": contentLocation,
  "about": [
    { "@type": "Organization", "name": project.client },
    ...(project.endCustomer ? [{ "@type": "Organization", "name": project.endCustomer }] : []),
    // Use Thing (not Vehicle) for the vessel/rig — Vehicle is a subtype of
    // Product in schema.org, which triggers the Rich Results Test to demand
    // offers/review/aggregateRating fields that don't apply to a chartered
    // marine asset. additionalType keeps the maritime semantic. The
    // stable @id is sitewide, so every case study that mentions the same
    // vessel ties back to the same entity node.
    ...(project.vessel ? [{
      "@type": "Thing",
      "@id": vesselId,
      "name": project.vessel,
      "additionalType": "https://en.wikipedia.org/wiki/Watercraft",
    }] : []),
  ],
  "keywords": [
    project.client,
    ...(project.endCustomer ? [project.endCustomer] : []),
    ...(project.vessel ? [project.vessel] : []),
    project.port,
    ...project.serviceTypes.map((s) => serviceLabels[s] || s),
    "marine logistics", "offshore", "Afrishore",
  ].join(", "),
  "isPartOf": { "@id": `${siteUrl}/#website` },
};

// Explicit Service entity — a direct structured claim that Afrishore
// provided this service, for this client, on this vessel, at this
// port, during this date range. Strongest possible schema-level
// assertion of who actually delivered the campaign.
const serviceSchema = {
  "@type": "Service",
  "@id": `${projectUrl}#service-delivery`,
  "name": `Marine logistics — ${project.title}`,
  "description": project.summary,
  "provider": { "@id": `${siteUrl}/#organization` },
  "serviceType": serviceLabels[primaryServiceTypeKey] || primaryServiceTypeKey,
  ...(primaryServiceCategoryId ? { "category": { "@id": primaryServiceCategoryId } } : {}),
  ...(project.vessel ? { "about": { "@id": vesselId } } : {}),
  "recipient": { "@type": "Organization", "name": project.client },
  ...(project.endCustomer ? { "audience": { "@type": "Organization", "name": project.endCustomer } } : {}),
  "areaServed": contentLocation,
  "temporalCoverage": temporalCoverage,
  "mainEntityOfPage": { "@type": "WebPage", "@id": projectUrl },
  "isPartOf": { "@id": `${projectUrl}#article` },
};

// Optional VideoObject — only emitted when the case study has a videoEmbed.
// Lets Google index the video as a discrete entity, surface it in video
// search and enrich the page's overall content signal. We supply the full
// rich-results recommended payload: thumbnail as ImageObject (alongside
// thumbnailUrl for legacy parsers), inLanguage, keywords derived from the
// case-study metadata, isFamilyFriendly, and an `about` link back to the
// Article so the two entities stay tied together in Google's KG.
const videoContentUrl = project.videoEmbed
  ? new URL(project.videoEmbed.src, siteUrl).toString()
  : "";
const videoKeywords = project.videoEmbed
  ? [
      project.vessel,
      project.client,
      project.port,
      "marine logistics",
      "vessel agency",
      "Southern Africa",
    ].filter(Boolean).join(", ")
  : "";
const videoSchema = project.videoEmbed ? {
  "@type": "VideoObject",
  "@id": `${projectUrl}#video`,
  "name": project.title,
  "description": project.videoEmbed.description,
  "thumbnailUrl": heroAbsolute,
  "thumbnail": {
    "@type": "ImageObject",
    "url": heroAbsolute,
    "width": 1920,
    "height": 1080,
  },
  "uploadDate": modifiedTime,
  "duration": project.videoEmbed.durationISO,
  "contentUrl": videoContentUrl,
  "width": project.videoEmbed.width || 1280,
  "height": project.videoEmbed.height || 720,
  "encodingFormat": "video/mp4",
  "inLanguage": "en",
  "isFamilyFriendly": true,
  "keywords": videoKeywords,
  "publisher": { "@id": `${siteUrl}/#organization` },
  "isPartOf": { "@id": `${projectUrl}#article` },
  "about": { "@id": `${projectUrl}#article` },
} : null;

const breadcrumb = [
  { name: "Home", item: "/" },
  { name: "Projects", item: "/projects" },
  { name: project.title, item: `/projects/${project.slug}` },
];
---

<BaseLayout
  title={metaTitle}
  description={metaDescription}
  ogImage={project.heroImage || "/og-image.jpg"}
  ogImageAlt={heroAlt}
  ogType="article"
  canonical={projectUrl}
  breadcrumb={breadcrumb}
  pageSchema={videoSchema ? [articleSchema, serviceSchema, videoSchema] : [articleSchema, serviceSchema]}
  articleMeta={{
    publishedTime,
    modifiedTime,
    section: "Case Study",
    tags: [project.client, project.port, ...(project.vessel ? [project.vessel] : [])],
  }}
  videoMeta={project.videoEmbed ? {
    url: videoContentUrl,
    type: "video/mp4",
    width: project.videoEmbed.width || 1280,
    height: project.videoEmbed.height || 720,
  } : undefined}
  preloadImage={project.videoEmbed
    ? (project.videoEmbed.posterSrc || project.heroImage)
    : undefined}
>
  <Navbar />

  <main id="main">
    <!-- Project hero — drop the bottom padding entirely on video-led
         case studies. The hero image is suppressed there, so the
         `pb-12` is purely empty space between the service tags and
         the body grid's `pt-12`. -->
    <section class:list={[
      "relative pt-32 lg:pt-40 px-6 lg:px-12",
      project.videoEmbed ? "pb-0" : "pb-12",
    ]}>
      <div class="max-w-5xl mx-auto">
        <!-- Back link -->
        <a
          href="/projects"
          class="inline-flex items-center gap-2 text-sm text-mute hover:text-gold transition-colors mb-10"
        >
          <span aria-hidden="true">←</span>
          All projects
        </a>

        <!-- Client tag -->
        <div class="flex items-center gap-3 text-xs uppercase tracking-[0.2em] text-gold font-semibold mb-6">
          <span>{project.client}</span>
          {project.endCustomer && (
            <>
              <span class="text-faint">·</span>
              <span class="text-faint normal-case tracking-normal">for {project.endCustomer}</span>
            </>
          )}
        </div>

        <!-- Title -->
        <h1
          class={`text-4xl md:text-5xl lg:text-6xl text-cream leading-[1.1] tracking-tight ${project.tagline ? "mb-4" : "mb-8"}`}
        >
          {project.title}
        </h1>

        {project.tagline && (
          <p class="text-lg lg:text-xl text-gold/90 mb-8 max-w-3xl leading-snug">
            {project.tagline}
          </p>
        )}

        <!-- Meta row -->
        <div class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-mute mb-10">
          <span class="flex items-center gap-2">
            <span class="text-faint text-xs uppercase tracking-[0.15em]">Year</span>
            <span class="text-cream">{project.year}</span>
          </span>
          <span class="flex items-center gap-2">
            <span class="text-faint text-xs uppercase tracking-[0.15em]">{project.locationLabel || "Port"}</span>
            <span class="text-cream">
              {portSegments.map((s, i) => [
                i > 0 ? <span class="text-faint"> · </span> : null,
                s.slug
                  ? <a href={`/ports/${s.slug}`} class="hover:text-gold transition-colors">{s.text}</a>
                  : s.text,
              ])}
            </span>
          </span>
          {project.vessel && (
            <span class="flex items-center gap-2">
              <span class="text-faint text-xs uppercase tracking-[0.15em]">{assetLabel}</span>
              <span class="text-cream">{project.vessel}</span>
            </span>
          )}
        </div>

        <!-- Service tags. Drop the bottom margin on video-led case
             studies — it was originally separating the tags from the
             hero image, which doesn't render when there's a video. -->
        <div class:list={[
          "flex flex-wrap gap-2",
          project.videoEmbed ? "mb-0" : "mb-12",
        ]}>
          {project.serviceTypes.map((s) => (
            <span class="text-xs uppercase tracking-[0.15em] text-mute border border-line px-3 py-1.5 rounded-sm">
              {serviceLabels[s] || s}
            </span>
          ))}
        </div>

        <!-- Hero image — suppressed when the case study has an in-body
             video, so the page leads straight to the video rather than
             showing a static hero above it. heroImage is still used for
             og:image, VideoObject.thumbnailUrl and the video poster. -->
        {!project.videoEmbed && (
          <div
            class="aspect-[16/9] w-full overflow-hidden rounded-sm border border-line relative"
            style={`background: ${placeholderBg};`}
          >
            {project.heroImage && (
              <img
                src={project.heroImage}
                alt={heroAlt}
                class="absolute inset-0 w-full h-full object-cover"
                loading="eager"
                width="1920"
                height="1080"
              />
            )}
          </div>
        )}
      </div>
    </section>

    <!-- Body + side card -->
    <section class="px-6 lg:px-12 pb-24 lg:pb-32">
      <div class="max-w-5xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 pt-12">
        <!-- Long-form outcome -->
        <div class="lg:col-span-8 space-y-6">
          {project.videoEmbed && (
            <div class="w-full overflow-hidden rounded-sm border border-line bg-base">
              <video
                controls
                playsinline
                preload="metadata"
                poster={project.videoEmbed.posterSrc || project.heroImage}
                width={project.videoEmbed.width || 1280}
                height={project.videoEmbed.height || 720}
                class="w-full h-auto block"
                aria-label={project.videoEmbed.description}
              >
                <source src={project.videoEmbed.src} type="video/mp4" />
                Your browser does not support inline video playback.
              </video>
            </div>
          )}
          {outcomeParagraphs.length > 0
            ? outcomeParagraphs.map((p) => (
                <p class="text-lg lg:text-xl leading-relaxed" style="color: rgba(245,242,235,0.88);">
                  {linkifyPorts(p).map((seg) =>
                    seg.type === "link"
                      ? <a href={seg.href} class="text-cream hover:text-gold transition-colors underline decoration-faint/30 underline-offset-4 hover:decoration-gold/60">{seg.text}</a>
                      : seg.value
                  )}
                </p>
              ))
            : (
              <>
                <p class="text-lg lg:text-xl leading-relaxed" style="color: rgba(245,242,235,0.88);">
                  {project.summary}
                </p>
                <p class="text-sm text-faint italic pt-4">
                  Full case study coming soon. Contact us for operational details on this project.
                </p>
              </>
            )
          }

          {project.secondaryImage && (
            <figure class={project.secondaryImage.portrait ? "space-y-3 max-w-md mx-auto pt-2" : "space-y-3 pt-2"}>
              <div
                class={`${project.secondaryImage.portrait ? "aspect-[3/4]" : "aspect-[3/2]"} w-full overflow-hidden rounded-sm border border-line relative`}
                style={`background: ${placeholderBg};`}
              >
                <picture>
                  <source srcset={webp(project.secondaryImage.src)} type="image/webp" />
                  <img
                    src={project.secondaryImage.src}
                    alt={project.secondaryImage.alt}
                    class="absolute inset-0 w-full h-full object-cover"
                    loading="lazy"
                    width={project.secondaryImage.portrait ? 1200 : 1920}
                    height={project.secondaryImage.portrait ? 1600 : 1440}
                  />
                </picture>
              </div>
              <figcaption class="text-sm text-faint leading-relaxed">
                {project.secondaryImage.caption}
              </figcaption>
            </figure>
          )}
        </div>

        <!-- Side card: project facts + CTA -->
        <aside class="lg:col-span-4">
          <div class="sticky top-28 bg-surface border border-line p-6 lg:p-7 rounded-sm space-y-5">
            <h2 class="text-xs uppercase tracking-[0.2em] text-gold font-semibold">
              Project Facts
            </h2>

            <dl class="space-y-4 text-sm">
              <div>
                <dt class="text-xs uppercase tracking-[0.15em] text-faint mb-1">Client</dt>
                <dd class="text-cream">{project.client}</dd>
              </div>
              {project.endCustomer && (
                <div>
                  <dt class="text-xs uppercase tracking-[0.15em] text-faint mb-1">End-customer</dt>
                  <dd class="text-cream">{project.endCustomer}</dd>
                </div>
              )}
              <div>
                <dt class="text-xs uppercase tracking-[0.15em] text-faint mb-1">Year</dt>
                <dd class="text-cream">{project.year}</dd>
              </div>
              <div>
                <dt class="text-xs uppercase tracking-[0.15em] text-faint mb-1">{project.locationLabel || "Port"}</dt>
                <dd class="text-cream">
                  {portSegments.map((s, i) => [
                    i > 0 ? <span class="text-faint"> · </span> : null,
                    s.slug
                      ? <a href={`/ports/${s.slug}`} class="hover:text-gold transition-colors">{s.text}</a>
                      : s.text,
                  ])}
                </dd>
              </div>
              {project.vessel && (
                <div>
                  <dt class="text-xs uppercase tracking-[0.15em] text-faint mb-1">{assetLabel}</dt>
                  <dd class="text-cream">{project.vessel}</dd>
                </div>
              )}
              <div>
                <dt class="text-xs uppercase tracking-[0.15em] text-faint mb-1">Services</dt>
                <dd class="text-cream leading-relaxed">
                  {project.serviceTypes.map((s) => serviceLabels[s] || s).join(" · ")}
                </dd>
              </div>
            </dl>

            <a
              href="/#contact"
              class="inline-flex items-center justify-center gap-2 w-full bg-orange hover:bg-gold text-base px-5 py-3 text-sm font-semibold tracking-wide transition-colors duration-200 rounded-sm"
            >
              Discuss your operation
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </aside>
      </div>
    </section>

    <!-- Related projects -->
    <section class="px-6 lg:px-12 py-20 lg:py-24 border-t border-line">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-xs uppercase tracking-[0.2em] text-gold font-semibold mb-8">
          Related Projects
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {related.map((p) => (
            <a
              href={`/projects/${p.slug}`}
              class="group block bg-surface border border-line hover:border-gold/40 transition-all duration-300 rounded-sm overflow-hidden"
            >
              <div
                class="aspect-[4/3] relative"
                style={`background: ${placeholderBg};`}
              >
                {p.heroImage && (
                  <img
                    src={p.heroImage}
                    alt={`${p.title} — ${p.client} project at ${p.port}`}
                    class="absolute inset-0 w-full h-full object-cover"
                    loading="lazy"
                    width="800"
                    height="600"
                  />
                )}
                <div class="absolute top-3 right-3 bg-base/80 backdrop-blur-sm px-2.5 py-1 text-[10px] font-semibold tracking-wider text-cream group-hover:text-gold transition-colors duration-300">
                  {p.year}
                </div>
              </div>
              <div class="p-5 space-y-2">
                <span class="block text-xs uppercase tracking-[0.15em] text-gold font-semibold">
                  {p.client}
                </span>
                <h3 class="text-cream group-hover:text-yellow transition-colors duration-200 leading-tight">
                  {p.title}
                </h3>
                <span class="block text-xs text-faint">{p.port}</span>
              </div>
            </a>
          ))}
        </div>

        <div class="mt-12 text-center">
          <a
            href="/projects"
            class="inline-flex items-center gap-2 text-gold hover:text-yellow transition-colors text-sm uppercase tracking-[0.15em] font-semibold"
          >
            View all projects
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
