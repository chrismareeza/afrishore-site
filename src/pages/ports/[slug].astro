---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import { ports, portContact, type PortPage } from "../../data/ports";
import { projects } from "../../data/projects";

export function getStaticPaths() {
  return ports.map((p) => ({
    params: { slug: p.slug },
    props: { port: p },
  }));
}

interface Props {
  port: PortPage;
}

const { port } = Astro.props;

// Sibling ports – every other licensed port in Afrishore's network.
// Surfacing these as inline links spreads link equity across the port
// cluster, gives Google a stronger topical signal, and makes Mossel
// Bay / Cape Town (which already index well) link directly to the
// ports still stuck in "Discovered – currently not indexed".
const siblingPorts = ports.filter((p) => p.slug !== port.slug);

// Phone precedence: per-office number (e.g. Walvis Bay's local
// Namibian line) → port-level number (licence-only ports, e.g.
// Lüderitz) → central switchboard.
const phoneE164 = port.office?.phoneE164 ?? port.phoneE164 ?? portContact.phoneE164;
const phoneDisplay = port.office?.phoneDisplay ?? port.phoneDisplay ?? portContact.phoneDisplay;

const siteUrl = "https://www.afrishore.co";
// Trailing slash matches the URL Cloudflare Pages actually serves
// (/ports/foo 308s to /ports/foo/). Aligning canonical with the served
// URL avoids the canonical-loop that pushes pages into "Crawled –
// currently not indexed".
const pageUrl = `${siteUrl}/ports/${port.slug}/`;

// Related case studies – published projects whose `port` string contains
// one of this port's match tokens (case-insensitive).
const related = projects
  .filter(
    (p) =>
      p.published &&
      port.matchPort.some((m) =>
        p.port.toLowerCase().includes(m.toLowerCase())
      )
  )
  .slice(0, 3);

const placeholderBg =
  "linear-gradient(135deg, #1a1410 0%, #ED7014 50%, #FDE64B 100%)";

const webp = (p: string) => p.replace(/\.jpe?g$/i, ".webp");

// Split a spec value into its tokens. Spaces inside a token become
// non-breaking ( ) so "360 m" never breaks the number onto one line
// and the "m" onto the next. A value with several "·"-separated tokens
// (e.g. the syncrolift repair lanes) becomes a multi-element array that
// the template stacks as a right-aligned list instead of an inline,
// dangling-separator wrap.
const unitTokens = (v: string) =>
  v.split("·").map((part) => part.trim().replace(/ /g, String.fromCharCode(160)));

// Progressive disclosure: a punchy lead stays visible, the detailed
// prose moves into a "More about" accordion below. A port can supply a
// dedicated one-line `lead`; otherwise the first intro paragraph leads
// and the rest become the detail.
const leadText = port.lead ?? port.intro[0];
const detailParas = port.lead ? port.intro : port.intro.slice(1);

// Scannable quick-facts strip – derived from the port's own data so it
// stays accurate for office vs licence-only ports.
const quickFacts: { label: string; value: string }[] = [
  { label: "Agency licence", value: "Own" },
  port.office
    ? { label: "Local office", value: port.office.addressLocality.split(",")[0].trim() }
    : { label: "Coverage", value: port.country },
  ...(port.portCode ? [{ label: "Port code", value: port.portCode }] : []),
  { label: "Quality system", value: "ISO 9001" },
];

// Facility cards adapt to count so a lone card sits at a comfortable
// width instead of stranded at one-third of the row.
const facilityCount = port.facilities?.docks.length ?? 0;
const facilityGrid =
  facilityCount <= 1
    ? "grid-cols-1 max-w-md"
    : facilityCount === 2 || facilityCount === 4
      ? "grid-cols-1 sm:grid-cols-2"
      : "grid-cols-1 sm:grid-cols-2 lg:grid-cols-3";

const heroAltText =
  port.heroAlt ||
  `Afrishore vessel and rig agent – Port of ${port.portName}, ${port.country}`;

const heroAbsolute = port.heroImage
  ? new URL(port.heroImage, siteUrl).toString()
  : new URL("/og-image.jpg", siteUrl).toString();

// Service JSON-LD – clean (no Offer/price). provider/isPartOf link into
// the global @graph; areaServed pins the specific port + country. For
// office ports, `about` ties the page to the LocalBusiness already
// emitted globally in BaseLayout (no duplicate entity).
const serviceSchema: Record<string, unknown> = {
  "@type": "Service",
  "@id": `${pageUrl}#service`,
  "name": `Vessel & Rig Agent: Port of ${port.portName}`,
  "serviceType": "Vessel & Rig Agency",
  "description": port.metaDescription,
  "url": pageUrl,
  "provider": { "@id": `${siteUrl}/#organization` },
  // Port pages are spokes of the Vessel & Rig Agency pillar –
  // isPartOf ties each to that vertical's Service node in the global
  // @graph (topical cluster signal; the page is agency-optimised).
  "isPartOf": { "@id": `${siteUrl}/#service-ship-rig-agency` },
  "areaServed": [
    { "@type": "Place", "name": `Port of ${port.portName}` },
    { "@type": "Country", "name": port.country },
  ],
  "image": heroAbsolute,
};
if (port.office) {
  serviceSchema.about = { "@id": `${siteUrl}/${port.office.localBusinessId}` };
}

const breadcrumb = [
  { name: "Home", item: "/" },
  { name: "Vessel & Rig Agency", item: "/services/ship-rig-agency/" },
  { name: `Port of ${port.portName}`, item: `/ports/${port.slug}/` },
];
---

<BaseLayout
  title={port.metaTitle}
  description={port.metaDescription}
  ogImage={port.heroImage || "/og-image.jpg"}
  ogImageAlt={port.heroAlt}
  canonical={pageUrl}
  breadcrumb={breadcrumb}
  pageSchema={[serviceSchema]}
>
  <Navbar />

  <main id="main">
    <!-- Port hero -->
    <section class="relative pt-32 lg:pt-40 pb-6 lg:pb-12 px-6 lg:px-12">
      <div class="max-w-5xl mx-auto">
        <a
          href="/services/ship-rig-agency/"
          class="inline-flex items-center gap-2 text-sm text-mute hover:text-gold transition-colors mb-10"
        >
          <span aria-hidden="true">←</span>
          Vessel & Rig Agency
        </a>

        <div class="text-base uppercase tracking-[0.2em] text-gold font-bold mb-6">
          Vessel & Rig Agency · {port.country}
        </div>

        <h1 class="text-4xl md:text-5xl lg:text-6xl text-cream leading-[1.1] tracking-tight mb-5">
          {port.h1}
        </h1>

        <p class="text-lg lg:text-xl text-gold/90 mb-10 max-w-3xl leading-snug">
          {port.geoSub}
        </p>

        <div
          class="aspect-[16/9] w-full overflow-hidden rounded-sm border border-line relative"
          style={`background: ${placeholderBg};`}
        >
          {port.heroImage && (
            <picture>
              <source srcset={webp(port.heroImage)} type="image/webp" />
              <img
                src={port.heroImage}
                alt={heroAltText}
                class="absolute inset-0 w-full h-full object-cover"
                loading="eager"
                fetchpriority="high"
                width="1920"
                height="1080"
              />
            </picture>
          )}
        </div>
      </div>
    </section>

    <!-- Body + side card -->
    <section class="px-6 lg:px-12 pb-24 lg:pb-32">
      <div class="max-w-5xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 pt-4 lg:pt-12">
        <div class="lg:col-span-8 space-y-10">
          <!-- Lead: a single punchy paragraph. The detailed prose lives
               in the "More about" accordion lower down so a first-time
               visitor isn't met with a wall of text. -->
          <p class="text-xl lg:text-2xl leading-relaxed text-cream/90">
            {leadText}
          </p>

          <!-- Quick-facts strip – scannable proof above the fold. -->
          <dl class="grid grid-cols-2 sm:grid-cols-4 gap-px bg-line border border-line rounded-sm overflow-hidden">
            {quickFacts.map((f) => (
              <div class="bg-base px-4 py-4">
                <dt class="text-[11px] uppercase tracking-[0.15em] text-faint mb-1.5 leading-[1.2] min-h-[2.4em]">{f.label}</dt>
                <dd class="text-cream font-medium leading-snug">{f.value}</dd>
              </div>
            ))}
          </dl>

          {port.secondaryImage && !port.facilities && (
            <figure class={port.secondaryImage.portrait ? "space-y-3 max-w-md mx-auto" : "space-y-3"}>
              <div
                class={`${port.secondaryImage.portrait ? "aspect-[3/4]" : "aspect-[3/2]"} w-full overflow-hidden rounded-sm border border-line relative`}
                style={`background: ${placeholderBg};`}
              >
                <picture>
                  <source srcset={webp(port.secondaryImage.src)} type="image/webp" />
                  <img
                    src={port.secondaryImage.src}
                    alt={port.secondaryImage.alt}
                    class="absolute inset-0 w-full h-full object-cover"
                    loading="lazy"
                    width={port.secondaryImage.portrait ? 1200 : 1920}
                    height={port.secondaryImage.portrait ? 1600 : 1440}
                  />
                </picture>
              </div>
              <figcaption class="text-sm text-faint leading-relaxed">
                {port.secondaryImage.caption}
              </figcaption>
            </figure>
          )}

          <div>
            <h2 class="text-base uppercase tracking-[0.2em] text-gold font-bold mb-5">
              What we handle at {port.portName}
            </h2>
            <ul class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-3">
              {port.scope.map((s) => (
                <li class="flex items-start gap-2 text-base text-cream/90">
                  <span class="text-orange mt-1 leading-none" aria-hidden="true">·</span>
                  <span>{s}</span>
                </li>
              ))}
            </ul>
          </div>

          <div>
            <h2 class="text-base uppercase tracking-[0.2em] text-gold font-bold mb-5">
              Vessel & rig types
            </h2>
            <div class="flex flex-wrap gap-2">
              {port.vesselTypes.map((v) => (
                <span class="text-xs uppercase tracking-[0.15em] text-mute border border-line px-3 py-1.5 rounded-sm">
                  {v}
                </span>
              ))}
            </div>
          </div>

          {port.facilities && (
            <div>
              <h2 class="text-base uppercase tracking-[0.2em] text-gold font-bold mb-5">
                {port.facilities.heading}
              </h2>
              {port.facilities.intro && (
                <p class="text-base text-mute leading-relaxed mb-6 max-w-2xl">
                  {port.facilities.intro}
                </p>
              )}
              <div class:list={["grid gap-4", facilityGrid]}>
                {port.facilities.docks.map((dock) => (
                  <div class="bg-surface border border-line rounded-sm p-5 lg:p-6">
                    <h3 class="text-cream font-medium mb-4 leading-snug">
                      {dock.name}
                    </h3>
                    <dl class="space-y-2.5">
                      {dock.specs.map((s) => {
                        const tokens = unitTokens(s.value);
                        return (
                          <div class="flex items-baseline justify-between gap-4 text-sm">
                            <dt class="text-mute leading-snug">{s.label}</dt>
                            <dd class="text-cream font-medium text-right">
                              {tokens.length > 1
                                ? tokens.map((t) => <span class="block">{t}</span>)
                                : tokens[0]}
                            </dd>
                          </div>
                        );
                      })}
                    </dl>
                  </div>
                ))}
              </div>
              {port.secondaryImage && (
                <figure class={port.secondaryImage.portrait ? "mt-6 space-y-3 max-w-md mx-auto" : "mt-6 space-y-3"}>
                  <div
                    class={`${port.secondaryImage.portrait ? "aspect-[3/4]" : "aspect-[3/2]"} w-full overflow-hidden rounded-sm border border-line relative`}
                    style={`background: ${placeholderBg};`}
                  >
                    <picture>
                      <source srcset={webp(port.secondaryImage.src)} type="image/webp" />
                      <img
                        src={port.secondaryImage.src}
                        alt={port.secondaryImage.alt}
                        class="absolute inset-0 w-full h-full object-cover"
                        loading="lazy"
                        width={port.secondaryImage.portrait ? 1200 : 1920}
                        height={port.secondaryImage.portrait ? 1600 : 1440}
                      />
                    </picture>
                  </div>
                  <figcaption class="text-sm text-faint leading-relaxed">
                    {port.secondaryImage.caption}
                  </figcaption>
                </figure>
              )}
              {port.facilities.source && (
                <p class="mt-5 text-sm">
                  <a
                    href={port.facilities.source.url}
                    target="_blank"
                    rel="noopener"
                    class="inline-flex items-center gap-1 text-gold hover:text-yellow transition-colors"
                  >
                    {port.facilities.source.label}
                    <span aria-hidden="true">↗</span>
                  </a>
                </p>
              )}
            </div>
          )}

          <!-- Depth layer: the full operational detail, collapsed by
               default. Native <details> keeps the prose in the DOM (so
               it indexes normally) while sparing the skim-reader. -->
          {detailParas.length > 0 && (
            <details class="group border border-line rounded-sm bg-surface/40 transition-colors hover:border-gold/40">
              <summary class="flex items-center justify-between gap-6 cursor-pointer list-none px-6 py-5">
                <span class="text-base uppercase tracking-[0.2em] text-gold font-bold">
                  More about Afrishore at {port.portName}
                </span>
                <span
                  class="flex-shrink-0 text-orange text-2xl leading-none transition-transform duration-300 group-open:rotate-45"
                  aria-hidden="true"
                >+</span>
              </summary>
              <div class="px-6 pb-6 space-y-4 max-w-3xl">
                {detailParas.map((p) => (
                  <p class="text-base lg:text-lg leading-relaxed text-mute">
                    {p}
                  </p>
                ))}
              </div>
            </details>
          )}

          <div class="border-t border-line pt-8">
            <h2 class="text-base uppercase tracking-[0.2em] text-gold font-bold mb-3">
              Vessel & rig agency at other ports
            </h2>
            <p class="text-sm text-mute leading-relaxed mb-4 max-w-2xl">
              Afrishore agents vessels and rigs at every licensed port in our
              Southern African network – {port.portName} is one of {ports.length}:
            </p>
            <ul class="flex flex-wrap gap-x-6 gap-y-2 text-sm">
              {siblingPorts.map((p) => (
                <li>
                  <a href={`/ports/${p.slug}/`} class="text-gold hover:text-yellow transition-colors">
                    {p.portName} →
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <div class="border-t border-line pt-8">
            <h2 class="text-base uppercase tracking-[0.2em] text-gold font-bold mb-3">
              Beyond agency at {port.portName}
            </h2>
            <p class="text-sm text-mute leading-relaxed mb-4 max-w-2xl">
              Vessel and rig agency is the focus here, but Afrishore runs
              these from {port.portName} too, under the same single point of
              accountability:
            </p>
            <ul class="flex flex-wrap gap-x-6 gap-y-2 text-sm">
              <li><a href="/services/offshore-supply-base/" class="text-gold hover:text-yellow transition-colors">Offshore Supply Base →</a></li>
              <li><a href="/services/integrated-logistics/" class="text-gold hover:text-yellow transition-colors">Integrated Logistics →</a></li>
              <li><a href="/services/crew-visa-services/" class="text-gold hover:text-yellow transition-colors">Crew &amp; Visa Services →</a></li>
            </ul>
          </div>
        </div>

        <aside class="lg:col-span-4">
          <div class="sticky top-28 bg-surface border border-line p-6 lg:p-7 rounded-sm space-y-5">
            {port.office ? (
              <>
                <h2 class="text-base uppercase tracking-[0.2em] text-gold font-bold">
                  {port.office.businessName || `Afrishore – ${port.portName}`}
                </h2>
                <address class="not-italic text-sm text-cream/90 leading-relaxed">
                  {port.office.streetAddress}<br />
                  {port.office.addressLocality}{port.office.addressRegion ? `, ${port.office.addressRegion}` : ""}<br />
                  {port.country}
                </address>
                <p class="text-xs text-faint leading-relaxed pt-1">
                  Own port agency licence · physical office
                </p>
                {port.office.mapsUrl && (
                  <a
                    href={port.office.mapsUrl}
                    target="_blank"
                    rel="noopener"
                    class="inline-flex items-center gap-1 text-sm text-gold hover:text-yellow transition-colors"
                  >
                    View on Google Maps
                    <span aria-hidden="true">↗</span>
                  </a>
                )}
              </>
            ) : (
              <>
                <h2 class="text-base uppercase tracking-[0.2em] text-gold font-bold">
                  Agency licence – {port.portName}
                </h2>
                <p class="text-sm text-cream/90 leading-relaxed">
                  Afrishore holds its own port agency licence for the Port of
                  {` ${port.portName}`}, {port.country}, coordinated from our
                  licensed office network.
                </p>
              </>
            )}

            <div class="space-y-1.5 text-sm border-t border-line pt-4">
              <a
                href={`tel:${phoneE164}`}
                class="block text-gold hover:text-yellow transition-colors"
              >
                {phoneDisplay}
              </a>
              <a
                href={`mailto:${portContact.email}?subject=${encodeURIComponent(`Afrishore – ${port.portName} enquiry`)}`}
                class="block text-gold hover:text-yellow transition-colors break-words"
              >
                {portContact.email}
              </a>
            </div>

            <a
              href="/#contact"
              class="inline-flex items-center justify-center gap-2 w-full bg-orange hover:bg-gold text-base px-5 py-3 text-sm font-semibold tracking-wide transition-colors duration-200 rounded-sm"
            >
              Discuss your {port.portName} call
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </aside>
      </div>
    </section>

    {related.length > 0 && (
      <section class="px-6 lg:px-12 py-20 lg:py-24 border-t border-line">
        <div class="max-w-5xl mx-auto">
          <h2 class="text-base uppercase tracking-[0.2em] text-gold font-bold mb-8">
            Afrishore at {port.portName}
          </h2>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {related.map((p) => (
              <a
                href={`/projects/${p.slug}/`}
                class="group block bg-surface border border-line hover:border-gold/40 transition-all duration-300 rounded-sm overflow-hidden"
              >
                <div class="aspect-[4/3] relative" style={`background: ${placeholderBg};`}>
                  {p.heroImage && (
                    <img
                      src={p.heroImage}
                      alt={`${p.title} – ${p.client} project at ${p.port}`}
                      class="absolute inset-0 w-full h-full object-cover"
                      loading="lazy"
                      width="800"
                      height="600"
                    />
                  )}
                  <div class="absolute top-3 right-3 bg-base/80 backdrop-blur-sm px-2.5 py-1 text-[10px] font-semibold tracking-wider text-cream group-hover:text-gold transition-colors duration-300">
                    {p.year}
                  </div>
                </div>
                <div class="p-5 space-y-2">
                  <span class="block text-xs uppercase tracking-[0.15em] text-gold font-semibold">
                    {p.client}
                  </span>
                  <h3 class="text-cream group-hover:text-yellow transition-colors duration-200 leading-tight">
                    {p.title}
                  </h3>
                  <span class="block text-xs text-faint">{p.port}</span>
                </div>
              </a>
            ))}
          </div>

          <div class="mt-12 text-center">
            <a
              href="/projects/"
              class="inline-flex items-center gap-2 text-gold hover:text-yellow transition-colors text-sm uppercase tracking-[0.15em] font-semibold"
            >
              View all projects
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </section>
    )}
  </main>

  <Footer />
</BaseLayout>
