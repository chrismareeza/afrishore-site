---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import Stats from "../components/Stats.astro";
import Projects from "../components/Projects.astro";
import Process from "../components/Process.astro";
import Services from "../components/Services.astro";
import Map from "../components/Map.astro";
import ClientsWall from "../components/ClientsWall.astro";
import Timeline from "../components/Timeline.astro";
import FAQ from "../components/FAQ.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout
  title="Afrishore Maritime Logistics"
  description="Integrated marine logistics across South Africa, Namibia & Mozambique. Vessel agency, customs, supply base operations, project cargo, crew logistics, bunkering, procurement. ISO 9001 certified since 2010."
>
  <Navbar />

  <main>
    <Hero />
    <About />
    <Stats />
    <Projects />
    <Process />
    <Services />
    <Map />
    <ClientsWall />
    <Timeline />
    <FAQ />
    <Contact />
  </main>

  <Footer />
</BaseLayout>
