import Timeline from "../components/Timeline.astro";
import FAQ from "../components/FAQ.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout
  title="Afrishore | Port Agency and Marine Logistics, Southern Africa"
  description="Integrated marine logistics agency operating across South Africa, Namibia and Mozambique since 2010. Vessel & rig agency, offshore supply base, integrated logistics, crew & visa. ISO 9001 certified. Trusted by TotalEnergies, Odfjell Drilling, Baker Hughes, Halliburton, Tidewater, SBM Offshore, Oceaneering and 13 more operators."
>
  <Navbar />

  <main>
    <Hero />
    <Services />
    <About />
    <Process />
    <Stats />
    <Projects />
    <Map />
    <ClientsWall />
    <Timeline />
    <FAQ />
    <Contact />
  </main>

  <Footer />
</BaseLayout>
