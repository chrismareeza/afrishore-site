---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import Stats from "../components/Stats.astro";
import Projects from "../components/Projects.astro";
import Process from "../components/Process.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout
  title="Afrishore — Local Solutions for Global Clients"
  description="Integrated marine logistics across South Africa, Namibia & Mozambique. Vessel agency, customs, supply base operations, project cargo, crew logistics, bunkering, procurement. ISO 9001 certified since 2010."
>
  <Navbar />

  <main>
    <Hero />
    <About />
    <Stats />
    <Projects />
    <Process />

    <!-- Placeholder for remaining sections -->
    <section class="py-32 px-6 lg:px-12 max-w-7xl mx-auto">
      <div class="text-center space-y-6">
        <span class="text-sm font-semibold uppercase tracking-[0.25em] text-gold">More Coming</span>
        <h2 class="text-3xl md:text-4xl text-cream max-w-3xl mx-auto leading-tight">
          Services · Map · Clients · Timeline · FAQ · Contact
        </h2>
        <p class="text-lg text-mute max-w-2xl mx-auto">
          Six more sections to land. Built and deployed on every commit.
        </p>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
