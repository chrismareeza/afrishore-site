---
import "../styles/global.css";
// Self-hosted fonts (Fontsource → Vite-fingerprinted woff2, served from
// our own origin). Replaces the render-blocking Google Fonts request;
// also a POPIA win (no visitor IPs to Google) and lets the CSP drop
// fonts.googleapis.com / fonts.gstatic.com. Latin subset, only the
// weights the design uses (400/500/600/700).
import "@fontsource/barlow/latin-400.css";
import "@fontsource/barlow/latin-500.css";
import "@fontsource/barlow/latin-600.css";
import "@fontsource/barlow/latin-700.css";
import "@fontsource/inter/latin-400.css";
import "@fontsource/inter/latin-500.css";
import "@fontsource/inter/latin-600.css";
import "@fontsource/inter/latin-700.css";
import ConsentBanner from "../components/ConsentBanner.astro";

// Resolve the build-time hashed URLs for the two most-critical font
// weights — Barlow 700 powers every above-the-fold display headline and
// Inter 400 carries most body copy. Preloading both in the document head
// lets the browser start the fetch in parallel with the CSS parse rather
// than waiting for the @font-face rule to be matched, which collapses
// the font-display:swap FOUT window that was driving CLS tail outliers.
import barlow700Url from "@fontsource/barlow/files/barlow-latin-700-normal.woff2?url";
import inter400Url from "@fontsource/inter/files/inter-latin-400-normal.woff2?url";

interface BreadcrumbStep {
  name: string;
  item: string; // absolute URL or path
}

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  /** Page-specific alt text for the OG image. Falls back to a generic
   *  brand description on pages that don't supply one. */
  ogImageAlt?: string;
  ogType?: "website" | "article";
  canonical?: string;
  /** Optional ordered breadcrumb trail rendered as BreadcrumbList JSON-LD. Omit on the homepage. */
  breadcrumb?: BreadcrumbStep[];
  /** Optional extra JSON-LD objects (eg per-page Article schema) to append to the global @graph. */
  pageSchema?: object[];
  /** Optional article-style metadata for project case studies. */
  articleMeta?: {
    publishedTime?: string;
    modifiedTime?: string;
    section?: string;
    tags?: string[];
  };
  /** Optional in-body video metadata. When provided, the layout emits
   *  og:video* tags so Facebook / LinkedIn shares preview the actual
   *  video, not just the poster image. */
  videoMeta?: {
    url: string;              // absolute https URL to the MP4
    type?: string;            // MIME, defaults to video/mp4
    width?: number;           // intrinsic pixel width
    height?: number;          // intrinsic pixel height
  };
}

const {
  title = "Afrishore | Port Agency and Marine Logistics, Southern Africa",
  description = "Integrated marine logistics agency operating across South Africa, Namibia and Mozambique since 2010. Vessel & rig agency, offshore supply base, integrated logistics, crew & visa. ISO 9001 certified. Trusted by TotalEnergies, Odfjell Drilling, Baker Hughes, Halliburton, Tidewater and 15 more operators.",
  ogImage = "/og-image.jpg",
  ogImageAlt,
  ogType = "website",
  canonical,
  breadcrumb,
  pageSchema = [],
  articleMeta,
  videoMeta,
} = Astro.props;

const siteUrl = "https://www.afrishore.co";
const fullCanonical = canonical || new URL(Astro.url.pathname, siteUrl).toString();
const absoluteOgImage = new URL(ogImage, siteUrl).toString();

// Only emit og:image:width/height when serving the canonical 1200×630 default.
// Per-page overrides (project hero images) ship at varying aspect ratios; let
// the crawler re-measure rather than declare wrong dimensions.
const isDefaultOgImage = ogImage === "/og-image.jpg";

// Concrete sub-services per vertical → OfferCatalog, so Google maps the
// full capability breadth (GAC/Rennies/Woker expose only flat HTML
// lists with no structured data). All entries are services Afrishore
// genuinely performs (mirrors the port/service scopes + GBP services).
const offerCatalog = (name: string, items: string[]) => ({
  "@type": "OfferCatalog",
  "name": name,
  "itemListElement": items.map((s) => ({
    "@type": "Offer",
    "itemOffered": { "@type": "Service", "name": s },
  })),
});

// Base @graph (Organization + 4 LocalBusiness + WebSite + 4 Service)
const baseGraph: object[] = [
  {
    "@type": "Organization",
    "@id": `${siteUrl}/#organization`,
    "name": "Afrishore",
