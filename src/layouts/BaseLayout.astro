  {
    "@type": "Service",
    "@id": `${siteUrl}/#service-crew-visa`,
    "serviceType": "Crew & Visa Services",
    "name": "Crew & Visa Services",
    "provider": { "@id": `${siteUrl}/#organization` },
    "areaServed": [
      { "@type": "Country", "name": "South Africa" },
      { "@type": "Country", "name": "Namibia" },
      { "@type": "Country", "name": "Mozambique" },
    ],
    "description":
      "Crew rotations, medivacs, visa & immigration optimisation for offshore and onshore personnel and third-party technicians — flight coordination, accommodation, transport, medical evacuation coordination.",
    "hasOfferCatalog": offerCatalog("Crew & Visa services", [
      "Crew rotations", "Flight coordination",
      "Accommodation & transport", "Visa & work-permit processing",
      "Immigration compliance", "Medical evacuation coordination",
    ]),
  },
];

// Optional BreadcrumbList — only render when caller supplied a trail.
const breadcrumbSchema = breadcrumb && breadcrumb.length > 0
  ? [{
      "@type": "BreadcrumbList",
      "itemListElement": breadcrumb.map((step, idx) => ({
        "@type": "ListItem",
        "position": idx + 1,
        "name": step.name,
        "item": step.item.startsWith("http") ? step.item : new URL(step.item, siteUrl).toString(),
      })),
    }]
  : [];

const finalGraph = [
  ...baseGraph,
  ...breadcrumbSchema,
  ...pageSchema,
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />

    <!-- Canonical-host guard: bounce the raw Cloudflare Pages domain to the
         live site so afrishore-site.pages.dev is not crawled or visited as
         duplicate content. Production host only — *.pages.dev preview
         deploys are left alone so the deploy-preview workflow still works.
         Runs before analytics so nothing fires on the wrong host. -->
    <script is:inline>
      (function () {
        var h = location.hostname;
        if (h === "afrishore-site.pages.dev" || h === "www.afrishore-site.pages.dev") {
          location.replace(
            "https://www.afrishore.co" + location.pathname + location.search + location.hash
          );
        }
      })();
    </script>

    <!-- Google Analytics 4 (G-E28C5EH0TG) with Consent Mode v2.
         analytics_storage defaults to DENIED (POPIA/GDPR); the consent
         banner flips it to 'granted' on Accept and the choice is
         remembered in localStorage. is:inline so Astro doesn't bundle
         the third-party snippet. -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){ dataLayer.push(arguments); }
      gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'denied',
        wait_for_update: 500
      });
      try {
        if (localStorage.getItem('afrishore-consent') === 'granted') {
          gtag('consent', 'update', { analytics_storage: 'granted' });
        }
      } catch (e) {}
      gtag('js', new Date());
      gtag('config', 'G-E28C5EH0TG');
    </script>
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-E28C5EH0TG"></script>

    <!-- Cloudflare Web Analytics (cookieless, privacy-first).
         is:inline keeps Astro from bundling the third-party beacon. -->
    <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "ac81d6efc4bf47618bcca4e30f845840"}'></script>

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={fullCanonical} />

    <!-- Default index/follow + grant Google maximal preview rights. The two
         `max-*-preview` directives unlock large image previews and full
         video previews in SERPs (per Google's docs); without them the
         preview defaults can clip rich-media features. -->
    <meta name="robots" content="index, follow, max-image-preview:large, max-video-preview:-1, max-snippet:-1" />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={fullCanonical} />
    <meta property="og:image" content={absoluteOgImage} />
    {isDefaultOgImage && <meta property="og:image:width" content="1200" />}
    {isDefaultOgImage && <meta property="og:image:height" content="630" />}
    <meta property="og:image:alt" content={ogImageAlt || "Afrishore — integrated marine logistics across South Africa, Namibia and Mozambique"} />
    <meta property="og:site_name" content="Afrishore" />
    <meta property="og:locale" content="en_ZA" />

    {ogType === "article" && articleMeta?.publishedTime && (
      <meta property="article:published_time" content={articleMeta.publishedTime} />
    )}
    {ogType === "article" && articleMeta?.modifiedTime && (
      <meta property="article:modified_time" content={articleMeta.modifiedTime} />
    )}
    {ogType === "article" && articleMeta?.section && (
      <meta property="article:section" content={articleMeta.section} />
    )}
    {ogType === "article" && articleMeta?.tags?.map((tag) => (
      <meta property="article:tag" content={tag} />
    ))}

    {/* og:video — emitted when the page hosts an MP4 the layout wants to
        offer as a social-preview asset. Both `og:video` and the
        `og:video:secure_url` alias are required by the spec; the type +
        dimensions help Facebook/LinkedIn render the correct player size. */}
    {videoMeta && (
      <>
        <meta property="og:video" content={videoMeta.url} />
        <meta property="og:video:secure_url" content={videoMeta.url} />
        <meta property="og:video:type" content={videoMeta.type || "video/mp4"} />
        {videoMeta.width && <meta property="og:video:width" content={String(videoMeta.width)} />}
        {videoMeta.height && <meta property="og:video:height" content={String(videoMeta.height)} />}
      </>
    )}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOgImage} />
    <meta name="twitter:image:alt" content="Afrishore — integrated marine logistics across South Africa, Namibia and Mozambique" />

    <!-- Favicon — square Africa mark (favicon.svg / .ico share one 1:1 canvas) -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Locale hint for search engines (single-language en-ZA) -->
    <link rel="alternate" hreflang="en-ZA" href={fullCanonical} />
    <link rel="alternate" hreflang="x-default" href={fullCanonical} />

    <!-- Theme colour -->
    <meta name="theme-color" content="#0A0A0A" />

    <!-- Preload the hero LCP image on the homepage so the browser starts the
         fetch in parallel with the CSS/JS parse instead of waiting for the
         CSS rule to be matched (~250 ms LCP win). media= matches the
         responsive hero exactly: phones preload the 1280w (~74 KB),
         desktop the 1920w — never both, no wasted bytes. WebP only
         (universal support; the JPEG stays as the CSS image-set fallback). -->
    {Astro.url.pathname === "/" && (
      <>
        <link
          rel="preload"
          as="image"
          href="/images/hero-cape-town-1280.webp"
          type="image/webp"
          media="(max-width: 768px)"
          fetchpriority="high"
        />
        <link
          rel="preload"
          as="image"
          href="/images/hero-cape-town.webp"
          type="image/webp"
          media="(min-width: 769px)"
          fetchpriority="high"
        />
      </>
    )}

    <!-- Fonts: Barlow (display) + Inter (body) are self-hosted via
         Fontsource (imported in the frontmatter → bundled, fingerprinted,
         long-cached from our origin). No external font request.

         Preload the two most-critical weights so the browser starts the
         woff2 fetch in parallel with CSS parse — collapses the FOUT
         window that was driving CLS tail outliers (0.215 / 0.377 in
         Cloudflare RUM). crossorigin attribute is required even for
         same-origin fonts per the preload spec. -->
    <link rel="preload" as="font" type="font/woff2" href={barlow700Url} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={inter400Url} crossorigin />


    <!-- JSON-LD: Organization + WebSite + LocalBusiness × 4 + Service × 4
         + optional BreadcrumbList + optional per-page schema (Article, etc.) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": finalGraph,
    })} />
  </head>

  <body class="bg-base text-cream font-sans antialiased">
    <a href="#main" class="skip-link">Skip to content</a>
    <slot />
    <ConsentBanner />

    <!-- Page-engagement conversions: fired on load of the destination
         (reliable — no click/unload race; also counts organic/direct
         arrivals). Service landing pages → `view_service`; individual
         case studies → `view_case_study` (the /projects listing index
         is excluded). Respects Consent Mode (gtag is consent-gated). -->
    <script is:inline>
      (function () {
        if (typeof window.gtag !== "function") return;
        var p = location.pathname;
        if (/^\/services\/[^/]+\/?$/.test(p)) {
          window.gtag("event", "view_service", { page_path: p });
        } else if (/^\/projects\/[^/]+\/?$/.test(p)) {
          window.gtag("event", "view_case_study", { page_path: p });
        }
      })();
    </script>

    <!-- Lead-intent tracking: one delegated listener fires a GA4
         `generate_lead` event on any phone, email, or #contact CTA
         (nav, hero, footer, service & project pages). No per-component
         wiring; respects Consent Mode (gtag is consent-gated). -->
    <script is:inline>
      (function () {
        document.addEventListener("click", function (e) {
          var a = e.target && e.target.closest && e.target.closest("a[href]");
          if (!a) return;
          var href = a.getAttribute("href") || "";
          var method;
          if (href.indexOf("tel:") === 0) method = "phone";
          else if (href.indexOf("mailto:") === 0) method = "email";
          else if (href.indexOf("#contact") !== -1) method = "cta";
          else return;
          if (typeof window.gtag === "function") {
            window.gtag("event", "generate_lead", {
              method: method,
              link_url: href,
              link_text: (a.textContent || "").trim().slice(0, 80)
            });
          }
        }, true);
      })();
    </script>
  </body>
</html>
