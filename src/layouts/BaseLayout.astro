    ]),
  },
  {
    "@type": "Service",
    "@id": `${siteUrl}/#service-supply-base`,
    "serviceType": "Offshore Supply Base Operations",
    "name": "Offshore Supply Base",
    "provider": { "@id": `${siteUrl}/#organization` },
    "areaServed": [
      { "@type": "Country", "name": "South Africa" },
      { "@type": "Country", "name": "Namibia" },
      { "@type": "Country", "name": "Mozambique" },
    ],
    "description":
      "Turnkey base operator services for onshore and offshore projects — rigging, cranage, abnormal trucking, warehousing, project cargo, waste management, materials management and reporting.",
    "hasOfferCatalog": offerCatalog("Offshore Supply Base services", [
      "Shore base operations", "Rigging & cranage",
      "Abnormal & heavy-lift trucking",
      "Warehousing, laydown & bonded storage",
      "Temporary importation & customs clearance",
      "Project cargo handling", "Waste management",
      "Materials management & reporting",
      "Mobilisation / demobilisation",
    ]),
  },
  {
    "@type": "Service",
    "@id": `${siteUrl}/#service-integrated-logistics`,
    "serviceType": "Integrated Logistics",
    "name": "Integrated Logistics",
    "provider": { "@id": `${siteUrl}/#organization` },
    "areaServed": [
      { "@type": "Country", "name": "South Africa" },
      { "@type": "Country", "name": "Namibia" },
      { "@type": "Country", "name": "Mozambique" },
    ],
    "description":
      "Freight forwarding, customs brokerage and materials management across sea, air and road — international freight, technical procurement, multidimensional procurement.",
    "hasOfferCatalog": offerCatalog("Integrated Logistics services", [
      "Freight forwarding (sea, air, road)", "Customs brokerage",
      "Cross-border transport", "Technical procurement",
