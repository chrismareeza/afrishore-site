  },
  {
    "@type": "LocalBusiness",
    "@id": `${siteUrl}/#durban`,
    "parentOrganization": { "@id": `${siteUrl}/#organization` },
    "image": `${siteUrl}/og-image.jpg`,
    "name": "Afrishore",
    "address": {
      "@type": "PostalAddress",
