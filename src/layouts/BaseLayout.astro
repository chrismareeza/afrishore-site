    "sameAs": ["https://share.google/xVkGsN7QUKWdDGqFN"],
  },
  // 4 core service verticals as discrete Service entries so Google can map
  // each capability independently rather than treating them as a flat list.
  {
    "@type": "Service",
    "@id": `${siteUrl}/#service-ship-rig-agency`,
    "serviceType": "Vessel & Rig Agency",
    "name": "Vessel & Rig Agency",
    // Canonical search-query variants for this service.
    "alternateName": [
      "Ships Agency", "Ships Agent", "Vessel Agent", "Vessel Agency",
    ],
    // Anchor to the Wikipedia entity for shipping agency so Google's
    // entity disambiguator places this Service in the right cluster.
    "additionalType": "https://en.wikipedia.org/wiki/Shipping_agency",
    "provider": { "@id": `${siteUrl}/#organization` },
    "areaServed": [
      { "@type": "Country", "name": "South Africa" },
      { "@type": "Country", "name": "Namibia" },
      { "@type": "Country", "name": "Mozambique" },
    ],
    "description":
      "Afrishore acts as ships agent and vessel agent across South Africa, Namibia and Mozambique — systemic ships agency and vessel agency services for rigs, drillships, OSVs, PSVs, liners, tankers and FPSOs covering port clearance, berth scheduling, immigration, husbandry, dry docking & repairs and procurement.",
    "hasOfferCatalog": offerCatalog("Vessel & Rig Agency services", [
      "Port agency", "Port & customs clearance",
