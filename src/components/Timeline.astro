---
// Section 9 · Company Timeline
// Horizontal scrolling milestones from 2010 → 2026
// Mobile: vertical stack instead of horizontal scroll

interface Milestone {
  year: string;
  title: string;
  body: string;
}

const milestones: Milestone[] = [
  { year: "2010", title: "Founded", body: "Afrishore established in Mossel Bay." },
  { year: "2013", title: "Subsea Pipelaying", body: "First subsea installation campaign for SBM Offshore." },
  { year: "2014", title: "TotalEnergies Brulpadda", body: "First Brulpadda drilling campaign supported (Eirik Raude rig)." },
  { year: "2018–19", title: "Brulpadda Discovery", body: "Largest gas-condensate find in SA waters in over a decade — Deepsea Stavanger." },
  { year: "2020–21", title: "Luiperd Campaign", body: "Twin-port supply base across Mossel Bay & Cape Town." },
  { year: "2022", title: "Namibia Expansion", body: "Deepsea Bollsta Jonker-1 campaign begins — embedded at Port of Walvis Bay." },
  { year: "2022–23", title: "2Africa Cable", body: "South African landing operations for Meta's 2Africa subsea cable." },
  { year: "2023", title: "Deepsea Mira Deployed", body: "Continuous Mira drilling support begins (Venus-1x → Tamboti-1x → Volans/Kharas)." },
  { year: "2025", title: "Dock Titan Heavy Lift", body: "Cape Town to Réunion floating dock transfer on MV Transshelf." },
  { year: "Today", title: "1,200+ tonnes/yr", body: "Operating across SA, Namibia, and Mozambique. ISO 9001 certified." },
];
---

<section id="timeline" class="relative bg-base py-24 lg:py-32 overflow-hidden">
  <div class="max-w-7xl mx-auto px-6 lg:px-12">
    <div class="max-w-3xl mb-16 lg:mb-20 space-y-6">
      <div data-anim="time-eyebrow" class="opacity-0 -translate-y-2">
        <span class="text-xs lg:text-sm font-semibold uppercase tracking-[0.25em] text-gold">
          Our Journey
        </span>
      </div>
      <h2
        data-anim="time-headline"
        class="opacity-0 translate-y-4 text-4xl md:text-5xl lg:text-6xl leading-[1.1] text-cream"
      >
        From a single port<br />
        <span class="gradient-text">to six.</span>
      </h2>
    </div>

    <!-- Desktop: horizontal scroll · Mobile: vertical stack -->
    <div class="relative">
      <div class="lg:overflow-x-auto lg:pb-8 lg:scrollbar-track-line lg:scrollbar-thumb-mute" id="timeline-scroll">
        <ol class="grid grid-cols-1 lg:flex lg:flex-row gap-8 lg:gap-12 lg:min-w-max">
          {milestones.map((m, i) => (
            <li
              data-anim="time-item"
              class="opacity-0 translate-y-6 relative lg:w-72 lg:flex-shrink-0 group"
            >
              <!-- Gradient dot + line for desktop -->
              <div class="flex lg:block items-center gap-6 mb-4 lg:mb-6">
                <div class="relative flex-shrink-0">
                  <span class="block w-4 h-4 rounded-full" style="background: linear-gradient(135deg, #ED7014, #FDE64B);"></span>
                  {i < milestones.length - 1 && (
                    <span class="hidden lg:block absolute top-1.5 left-4 w-72 h-px bg-line"></span>
                  )}
                </div>
                <span class="font-display text-3xl lg:text-4xl gradient-text leading-none">
                  {m.year}
                </span>
              </div>

              <h3 class="text-lg lg:text-xl text-cream mb-2 leading-tight">
                {m.title}
              </h3>
              <p class="text-sm text-mute leading-relaxed">
                {m.body}
              </p>
            </li>
          ))}
        </ol>
      </div>

      <!-- Scroll hint (desktop only, fades after scroll) -->
      <div class="hidden lg:flex items-center gap-2 mt-6 text-xs text-faint uppercase tracking-[0.15em]">
        <span>Scroll horizontally</span>
        <span aria-hidden="true">→</span>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  gsap.timeline({
    scrollTrigger: { trigger: "#timeline", start: "top 75%", toggleActions: "play none none none" },
    defaults: { ease: "power3.out", duration: 0.9 },
  })
    .to("[data-anim='time-eyebrow']", { opacity: 1, y: 0 }, 0)
    .to("[data-anim='time-headline']", { opacity: 1, y: 0, duration: 1.1 }, 0.15);

  // Stagger milestones in
  gsap.to("[data-anim='time-item']", {
    opacity: 1,
    y: 0,
    duration: 0.8,
    stagger: 0.1,
    ease: "power3.out",
    scrollTrigger: {
      trigger: "[data-anim='time-item']",
      start: "top 85%",
      toggleActions: "play none none none",
    },
  });
</script>
