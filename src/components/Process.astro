---
// Section 5 · Process Workflow
// 4 numbered steps with gradient accent numbers
// Sticky-scroll effect: as user scrolls, previous step fades, next becomes prominent

interface Step {
  num: string;
  title: string;
  body: string;
}

const steps: Step[] = [
  {
    num: "01",
    title: "Pre-Arrival",
    body: "Visa & immigration facilitation, port clearance documentation, supplier sourcing, flight & accommodation coordination — locked in before the vessel arrives.",
  },
  {
    num: "02",
    title: "Port Clearance",
    body: "Customs and immigration, agency formalities, crew rotation, medivac coordination. Cleared and operational on arrival, every time.",
  },
  {
    num: "03",
    title: "Operations",
    body: "Bunkering, chandling, materials management, warehousing, project cargo coordination, rigging, cranage and waste management — all on the ground.",
  },
  {
    num: "04",
    title: "Demobilisation",
    body: "Outbound clearance, customs export, crew repatriation, final reconciliation. Closed out clean.",
  },
];
---

<section id="process" class="relative bg-base py-24 lg:py-32">
  <div class="max-w-7xl mx-auto px-6 lg:px-12">
    <!-- Section header -->
    <div class="max-w-3xl mb-20 space-y-6">
      <div data-anim="proc-eyebrow" class="opacity-0 -translate-y-2">
        <span class="text-xs lg:text-sm font-semibold uppercase tracking-[0.25em] text-gold">
          How We Operate
        </span>
      </div>
      <h2
        data-anim="proc-headline"
        class="opacity-0 translate-y-4 text-4xl md:text-5xl lg:text-6xl leading-[1.1] text-cream"
      >
        From pre-arrival to demob —<br />
        <span class="gradient-text">one continuous chain.</span>
      </h2>
    </div>

    <!-- Steps -->
    <div class="space-y-px">
      {steps.map((step) => (
        <article
          data-anim="proc-step"
          class="opacity-0 translate-y-6 group relative grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-10 py-10 lg:py-14 border-t border-line hover:border-gold/40 transition-colors duration-300"
        >
          <!-- Number -->
          <div class="lg:col-span-3">
            <span
              class="block text-6xl md:text-7xl lg:text-8xl font-display leading-none gradient-text"
            >
              {step.num}
            </span>
          </div>

          <!-- Content -->
          <div class="lg:col-span-9 space-y-4">
            <h3 class="text-2xl md:text-3xl lg:text-4xl text-cream leading-tight group-hover:translate-x-2 transition-transform duration-300">
              {step.title}
            </h3>
            <p class="text-lg text-mute leading-relaxed max-w-2xl">
              {step.body}
            </p>
          </div>
        </article>
      ))}

      <!-- Closing divider (so last step has a line below it too) -->
      <div class="border-t border-line"></div>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  // Section header reveal
  const tl = gsap.timeline({
    scrollTrigger: {
      trigger: "#process",
      start: "top 75%",
      toggleActions: "play none none none",
    },
    defaults: { ease: "power3.out", duration: 0.9 },
  });

  tl.to("[data-anim='proc-eyebrow']", { opacity: 1, y: 0 }, 0)
    .to("[data-anim='proc-headline']", { opacity: 1, y: 0, duration: 1.1 }, 0.15);

  // Steps reveal with stagger as user scrolls through
  gsap.utils.toArray<HTMLElement>("[data-anim='proc-step']").forEach((el) => {
    gsap.to(el, {
      opacity: 1,
      y: 0,
      duration: 0.9,
      ease: "power3.out",
      scrollTrigger: {
        trigger: el,
        start: "top 85%",
        toggleActions: "play none none none",
      },
    });
  });
</script>
