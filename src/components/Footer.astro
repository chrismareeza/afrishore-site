<footer class="bg-surface border-t border-line">
  <div class="mx-auto max-w-7xl px-6 lg:px-12 py-16">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-12">
      <!-- Brand column -->
      <div class="md:col-span-1">
        <img src="/logos/SVG-12.svg" alt="Afrishore" class="h-14 lg:h-16 w-auto mb-5" width="1137" height="264" />
        <p class="text-sm text-mute leading-relaxed">
          Local Solutions for Global Clients.<br />
          ISO 9001 certified since 2010.
        </p>
      </div>

      <!-- Services -->
      <div>
        <h4 class="text-xs uppercase tracking-[0.2em] text-gold mb-4 font-sans font-semibold">Services</h4>
        <ul class="space-y-2 text-sm text-mute">
          <li><a href="#services" class="hover:text-cream transition-colors">Vessel &amp; Rig Agency</a></li>
          <li><a href="#services" class="hover:text-cream transition-colors">Offshore Supply Base</a></li>
          <li><a href="#services" class="hover:text-cream transition-colors">Integrated Logistics</a></li>
          <li><a href="#services" class="hover:text-cream transition-colors">Crew &amp; Visa</a></li>
