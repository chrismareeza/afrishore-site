---
// Section 8 · Client Wall
// Grid of client logos in rows. Default: white silhouette via CSS filter.
// On hover: filter removed → full-colour logo revealed.
// Clients without a logo render as monochrome text plates with the same hover treatment.
import { clients } from "../data/clients";
---

<section id="clients" class="relative bg-base pt-24 lg:pt-32 pb-12 lg:pb-16 overflow-hidden border-y border-line">
  <div class="max-w-7xl mx-auto px-6 lg:px-12 mb-12 lg:mb-16">
    <div class="max-w-3xl space-y-6">
      <div data-anim="cli-eyebrow" class="opacity-0 -translate-y-2">
        <span class="text-xs lg:text-sm font-semibold uppercase tracking-[0.25em] text-gold">
          Trusted By
        </span>
      </div>
      <h2
        data-anim="cli-headline"
        class="opacity-0 translate-y-4 text-3xl md:text-4xl lg:text-5xl leading-tight text-cream"
      >
        Operators, owners and service contractors across the<br />
        <span class="text-gold">African energy sector.</span>
      </h2>
    </div>
  </div>

  <!-- Logo grid: 2 cols mobile, 3 cols tablet, 5 cols desktop -->
  <div class="max-w-7xl mx-auto px-6 lg:px-12">
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-px bg-line/40 border border-line/40 rounded-sm overflow-hidden">
      {clients.map((client) => (
        <div
          data-anim="cli-cell"
          class="cli-cell opacity-0 group relative aspect-[3/2] bg-base flex items-center justify-center p-6 lg:p-8 overflow-hidden transition-all duration-300"
        >
          <!-- Top gradient bar – draws on hover -->
          <span
            class="absolute top-0 left-0 right-0 h-[2px] origin-left scale-x-0 group-hover:scale-x-100 transition-transform duration-500 z-10"
            style="background: linear-gradient(90deg, #ED7014, #FDE64B);"
          ></span>

          {client.logo ? (
            <img
              src={client.logo}
              alt={`${client.name} logo`}
              class="client-logo max-h-12 lg:max-h-14 max-w-full w-auto object-contain"
              style={client.displayBoost ? `transform: scale(${client.displayBoost});` : undefined}
              loading="lazy"
              decoding="async"
              width="200"
              height="80"
            />
          ) : (
            <span class="client-text text-xs md:text-sm font-semibold text-cream uppercase tracking-[0.12em] text-center leading-tight transition-colors duration-300">
              {client.name}
            </span>
          )}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* Logos: inverted-luminance treatment by default – internal details preserved
     as darker cutouts in lighter shapes (e.g. the "S" in Solstad's flag, the
     "B" in Bourbon's mark). Full colour on hover.
     Also: any white background in the source logo inverts to black, which
     matches the dark site bg → effectively transparent. */
  .client-logo {
    filter: grayscale(100%) invert(1);
    opacity: 0.85;
    transition: filter 0.35s ease, opacity 0.35s ease;
  }

  .group:hover .client-logo {
    filter: none;
    opacity: 1;
  }

  /* Text plates (no logo yet): muted by default, gold on hover */
  .client-text {
    color: rgba(245, 242, 235, 0.55);
  }

  .group:hover .client-text {
    color: #F5AB2F;
  }

  /* Hover: orange-glow border (inset box-shadow stays within cell bounds, doesn't disturb grid layout) + subtle warm tint */
  .cli-cell {
    transition: background-color 0.3s ease, box-shadow 0.35s ease;
  }
  .cli-cell:hover {
    background-color: rgba(20, 20, 20, 1); /* surface */
    box-shadow:
      inset 0 0 0 1px rgba(237, 112, 20, 0.55),
      inset 0 0 20px rgba(237, 112, 20, 0.10);
  }

  @media (prefers-reduced-motion: reduce) {
    .client-logo,
    .client-text,
    .cli-cell {
      transition: none;
    }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  // Header reveal
  gsap.timeline({
    scrollTrigger: { trigger: "#clients", start: "top 75%", toggleActions: "play none none none" },
    defaults: { ease: "power3.out", duration: 0.9 },
  })
    .to("[data-anim='cli-eyebrow']", { opacity: 1, y: 0 }, 0)
    .to("[data-anim='cli-headline']", { opacity: 1, y: 0, duration: 1.1 }, 0.15);

  // Cell stagger reveal
  gsap.to("[data-anim='cli-cell']", {
    opacity: 1,
    duration: 0.6,
    stagger: 0.05,
    ease: "power2.out",
    scrollTrigger: {
      trigger: "[data-anim='cli-cell']",
      start: "top 85%",
      toggleActions: "play none none none",
    },
  });
</script>
