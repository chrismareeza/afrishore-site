---
// Section 8 · Client Wall
// Grid of client logos in rows. Default: white silhouette via CSS filter.
// On hover: filter removed → full-colour logo revealed.
// Clients without a logo render as monochrome text plates with the same hover treatment.
import { clients } from "../data/clients";
---

<section id="clients" class="relative bg-base py-24 lg:py-32 overflow-hidden border-y border-line">
  <div class="max-w-7xl mx-auto px-6 lg:px-12 mb-12 lg:mb-16">
    <div class="max-w-3xl space-y-6">
      <div data-anim="cli-eyebrow" class="opacity-0 -translate-y-2">
        <span class="text-xs lg:text-sm font-semibold uppercase tracking-[0.25em] text-gold">
          Trusted By
        </span>
      </div>
      <h2
        data-anim="cli-headline"
        class="opacity-0 translate-y-4 text-3xl md:text-4xl lg:text-5xl leading-tight text-cream"
      >
        Operators, drillers, and service contractors<br />
        across the <span class="text-gold">African energy sector.</span>
      </h2>
    </div>
  </div>

  <!-- Logo grid: 2 cols mobile, 3 cols tablet, 5 cols desktop -->
  <div class="max-w-7xl mx-auto px-6 lg:px-12">
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-px bg-line/40 border border-line/40 rounded-sm overflow-hidden">
      {clients.map((client) => (
        <div
          data-anim="cli-cell"
          class="opacity-0 group aspect-[3/2] bg-base hover:bg-surface flex items-center justify-center p-6 lg:p-8 transition-colors duration-300"
        >
          {client.logo ? (
            <img
              src={client.logo}
              alt={client.name}
              class="client-logo max-h-12 lg:max-h-14 max-w-full w-auto object-contain"
              loading="lazy"
            />
          ) : (
            <span class="client-text text-xs md:text-sm font-semibold text-cream uppercase tracking-[0.12em] text-center leading-tight transition-colors duration-300">
              {client.name}
            </span>
          )}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* Logos: pure white silhouette by default, full colour on hover */
  .client-logo {
    filter: grayscale(100%) brightness(0) invert(1);
    opacity: 0.7;
    transition: filter 0.35s ease, opacity 0.35s ease;
  }

  .group:hover .client-logo {
    filter: none;
    opacity: 1;
  }

  /* Text plates (no logo yet): muted by default, gold on hover */
  .client-text {
    color: rgba(245, 242, 235, 0.55);
  }

  .group:hover .client-text {
    color: #F5AB2F;
  }

  @media (prefers-reduced-motion: reduce) {
    .client-logo,
    .client-text {
      transition: none;
    }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  // Header reveal
  gsap.timeline({
    scrollTrigger: { trigger: "#clients", start: "top 75%", toggleActions: "play none none none" },
    defaults: { ease: "power3.out", duration: 0.9 },
  })
    .to("[data-anim='cli-eyebrow']", { opacity: 1, y: 0 }, 0)
    .to("[data-anim='cli-headline']", { opacity: 1, y: 0, duration: 1.1 }, 0.15);

  // Cell stagger reveal
  gsap.to("[data-anim='cli-cell']", {
    opacity: 1,
    duration: 0.6,
    stagger: 0.05,
    ease: "power2.out",
    scrollTrigger: {
      trigger: "[data-anim='cli-cell']",
      start: "top 85%",
      toggleActions: "play none none none",
    },
  });
</script>
