---
// Section 7 · Coastal Footprint Map
// Stylized SVG of SA + Namibia + Mozambique coastline
// 4 office pins (orange, large) + 6 service port pins (gold, small)

interface Pin {
  x: number;
  y: number;
  name: string;
  sub?: string;
  isHQ?: boolean;
  labelPos?: "right" | "left" | "below"; // default "right"
}

const offices: Pin[] = [
  { x: 200, y: 215, name: "Walvis Bay", sub: "Port of Walvis Bay, Oil & Gas Section", labelPos: "left" },
  { x: 290, y: 568, name: "Cape Town", sub: "Unit 213, Buchanan Square", labelPos: "left" },
  { x: 390, y: 615, name: "Mossel Bay", sub: "58 Bland Street", isHQ: true, labelPos: "below" },
  { x: 625, y: 510, name: "Durban", sub: "33 Wagtail Walk, Yellowwood Park" },
];

const ports: Pin[] = [
  { x: 232, y: 360, name: "Lüderitz" },
  { x: 275, y: 525, name: "Saldanha" },
  { x: 490, y: 612, name: "Coega / Port Elizabeth" },
  { x: 555, y: 590, name: "East London" },
  { x: 820, y: 125, name: "Pemba" },
];
---

<section id="map" class="relative bg-base py-24 lg:py-32 overflow-hidden">
  <div class="max-w-7xl mx-auto px-6 lg:px-12">
    <div class="max-w-3xl mb-16 space-y-6">
      <div data-anim="map-eyebrow" class="opacity-0 -translate-y-2">
        <span class="text-xs lg:text-sm font-semibold uppercase tracking-[0.25em] text-gold">
          Footprint
        </span>
      </div>
      <h2
        data-anim="map-headline"
        class="opacity-0 translate-y-4 text-4xl md:text-5xl lg:text-6xl leading-[1.1] text-cream"
      >
        Four offices. Six service ports.<br />
        <span class="text-gold">One coast.</span>
      </h2>
      <p
        data-anim="map-sub"
        class="opacity-0 translate-y-4 text-lg text-mute max-w-2xl"
      >
        From Mossel Bay headquarters to Pemba — Afrishore is on the ground across South Africa, Namibia, and Mozambique.
      </p>
    </div>

    <!-- Map -->
    <div
      data-anim="map-svg"
      class="opacity-0 relative w-full aspect-[10/7] max-w-5xl mx-auto bg-surface/40 rounded-sm border border-line p-4 md:p-8"
    >
      <svg
        viewBox="0 0 1000 700"
        xmlns="http://www.w3.org/2000/svg"
        role="img"
        aria-label="Afrishore operational footprint across South Africa, Namibia and Mozambique"
        class="w-full h-full"
      >
        <defs>
          <linearGradient id="coastGradient" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#ED7014" />
            <stop offset="100%" stop-color="#FDE64B" />
          </linearGradient>
          <radialGradient id="pinPulse" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color="#ED7014" stop-opacity="0.5" />
            <stop offset="100%" stop-color="#ED7014" stop-opacity="0" />
          </radialGradient>
        </defs>

        <!-- Country labels — subtle background type, positioned inland of each coast -->
        <text x="230" y="135" fill="#2A2A2A" font-family="Inter, sans-serif" font-size="13" letter-spacing="0.25em" font-weight="600">NAMIBIA</text>
        <text x="370" y="500" fill="#2A2A2A" font-family="Inter, sans-serif" font-size="13" letter-spacing="0.25em" font-weight="600">SOUTH AFRICA</text>
        <text x="715" y="180" text-anchor="middle" fill="#2A2A2A" font-family="Inter, sans-serif" font-size="13" letter-spacing="0.25em" font-weight="600">MOZAMBIQUE</text>

        <!-- Country borders — thin faint gold dashed lines, geographically accurate.
             5 countries (NA, SA, MZ, Bot, Zim) meeting at 6 tri-points:
             - NA-Bot-Zam (Caprivi) ≈ (360, 100)
             - Bot-Zim-Zam          ≈ (455, 105)
             - Zim-Zam-MZ           ≈ (580, 85)
             - NA-Bot-SA            ≈ (342, 365)
             - Bot-Zim-SA           ≈ (512, 331)
             - SA-Zim-MZ            ≈ (632, 340)
        -->
        <g class="opacity-0" data-borders>
          <!-- NAMIBIA outline (excl Atlantic coast): N (Angola) → E (Bot) → S (Orange River) -->
          <path
            d="M 200 105 L 360 100 L 342 365 Q 290 388, 240 412"
            stroke="#F5AB2F"
            stroke-width="1"
            stroke-opacity="0.4"
            stroke-dasharray="4 4"
            fill="none"
          />

          <!-- SA's inland borders: NA tri → Bot tri → Zim tri → MZ coast (Lebombo) -->
          <path
            d="M 342 365 L 512 331 L 632 340 L 660 441"
            stroke="#F5AB2F"
            stroke-width="1"
            stroke-opacity="0.4"
            stroke-dasharray="4 4"
            fill="none"
          />

          <!-- Botswana-Zimbabwe border -->
          <path
            d="M 455 105 L 512 331"
            stroke="#F5AB2F"
            stroke-width="1"
            stroke-opacity="0.4"
            stroke-dasharray="4 4"
            fill="none"
          />

          <!-- Northern boundary across inland (Angola/Zambia/Tanzania edges):
               NA-Bot tri → Bot-Zim tri → Zim-MZ tri → MZ-Tanzania coast -->
          <path
            d="M 360 100 L 455 105 L 580 85 Q 700 115, 820 115"
            stroke="#F5AB2F"
            stroke-width="1"
            stroke-opacity="0.4"
            stroke-dasharray="4 4"
            fill="none"
          />

          <!-- Zimbabwe-Mozambique border (north tri-point south to SA-Zim-MZ tri-point) -->
          <path
            d="M 580 85 L 632 340"
            stroke="#F5AB2F"
            stroke-width="1"
            stroke-opacity="0.4"
            stroke-dasharray="4 4"
            fill="none"
          />
        </g>

        <!-- Coastline (will animate via stroke-dashoffset) -->
        <path
          id="coastline-path"
          d="M 200 80
             C 220 150, 180 230, 210 290
             C 220 350, 240 390, 240 440
             C 245 480, 270 520, 290 565
             C 295 595, 310 620, 360 615
             C 430 615, 490 610, 540 595
             C 580 575, 615 525, 650 460
             C 680 395, 710 315, 750 235
             C 790 155, 820 115, 850 90"
          stroke="url(#coastGradient)"
          stroke-width="3"
          fill="none"
          stroke-linecap="round"
          pathLength="1"
          stroke-dasharray="1"
          stroke-dashoffset="1"
        />

        <!-- Office pins (orange + pulse halo) -->
        {offices.map((o) => (
          <g class="opacity-0" data-pin="office">
            <circle cx={o.x} cy={o.y} r="22" fill="url(#pinPulse)" />
            <circle cx={o.x} cy={o.y} r={o.isHQ ? 10 : 8} fill="#ED7014" />
            {o.labelPos === "below" ? (
              <text x={o.x} y={o.y + 38} text-anchor="middle" fill="#F5F2EB" font-family="Inter, sans-serif" font-size="15" font-weight="600">
                {o.name}
              </text>
            ) : o.labelPos === "left" ? (
              <text x={o.x - 18} y={o.y + 5} text-anchor="end" fill="#F5F2EB" font-family="Inter, sans-serif" font-size="15" font-weight="600">
                {o.name}
              </text>
            ) : (
              <text x={o.x + 18} y={o.y + 5} fill="#F5F2EB" font-family="Inter, sans-serif" font-size="15" font-weight="600">
                {o.name}
              </text>
            )}
          </g>
        ))}

        <!-- Service port pins (gold, small, dark stroke for visibility against gradient coastline) -->
        {ports.map((p) => (
          <g class="opacity-0" data-pin="port">
            <circle cx={p.x} cy={p.y} r="5" fill="#FDE64B" stroke="#0A0A0A" stroke-width="1" />
            <text x={p.x + 10} y={p.y + 4} fill="#A39E94" font-family="Inter, sans-serif" font-size="11">{p.name}</text>
          </g>
        ))}
      </svg>

      <!-- Legend -->
      <div class="absolute bottom-4 right-4 md:bottom-6 md:right-6 flex items-center gap-6 text-xs text-mute bg-base/60 backdrop-blur-sm px-4 py-2 rounded-sm">
        <div class="flex items-center gap-2">
          <span class="w-3 h-3 rounded-full bg-orange"></span>
          <span>Office</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-yellow"></span>
          <span>Service port</span>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  // Section header reveal
  gsap.timeline({
    scrollTrigger: { trigger: "#map", start: "top 75%", toggleActions: "play none none none" },
    defaults: { ease: "power3.out", duration: 0.9 },
  })
    .to("[data-anim='map-eyebrow']", { opacity: 1, y: 0 }, 0)
    .to("[data-anim='map-headline']", { opacity: 1, y: 0, duration: 1.1 }, 0.15)
    .to("[data-anim='map-sub']", { opacity: 1, y: 0 }, 0.4)
    .to("[data-anim='map-svg']", { opacity: 1, duration: 0.8 }, 0.6);

  // Coastline draws on viewport entry
  ScrollTrigger.create({
    trigger: "#coastline-path",
    start: "top 80%",
    once: true,
    onEnter: () => {
      gsap.to("#coastline-path", {
        strokeDashoffset: 0,
        duration: 2.4,
        ease: "power2.inOut",
        onComplete: () => {
          // Country borders fade in subtly after coast
          gsap.to("[data-borders]", {
            opacity: 1,
            duration: 1.2,
            ease: "power2.out",
          });
          // Pins drop in with stagger after coastline completes
          gsap.to("[data-pin='office']", {
            opacity: 1,
            duration: 0.6,
            stagger: 0.12,
            delay: 0.3,
            ease: "power3.out",
          });
          gsap.to("[data-pin='port']", {
            opacity: 1,
            duration: 0.4,
            stagger: 0.08,
            delay: 0.6,
            ease: "power2.out",
          });
        },
      });
    },
  });
</script>
