---
// Section 7 · Coastal Footprint Map
// Stylized SVG of SA + Namibia + Mozambique coastline
// 4 office pins (orange, large) + 6 port pins (gold, small).
// Footprint: 4 offices · 6 agency-licence ports (Saldanha, Durban,
// Mossel Bay, Cape Town, Lüderitz, Walvis Bay) · 4 project ports
// (Gqeberha, Coega, Pemba, East London). Pins shown = non-office ports.

interface Pin {
  x: number;
  y: number;
  name: string;
  sub?: string;
  isHQ?: boolean;
  labelPos?: "right" | "left" | "below" | "above"; // default "right"
}

const offices: Pin[] = [
  { x: 200, y: 215, name: "Walvis Bay", sub: "Port of Walvis Bay, Oil & Gas Section", labelPos: "left" },
  { x: 290, y: 568, name: "Cape Town", sub: "Unit 213, Buchanan Square", labelPos: "left" },
  { x: 390, y: 615, name: "Mossel Bay", sub: "58 Bland Street", isHQ: true, labelPos: "below" },
  { x: 625, y: 510, name: "Durban", sub: "33 Wagtail Walk, Yellowwood Park" },
];

const ports: Pin[] = [
  { x: 232, y: 360, name: "Lüderitz" },
  { x: 275, y: 525, name: "Saldanha" },
  { x: 492, y: 610, name: "Coega", labelPos: "above" },
  { x: 510, y: 616, name: "Gqeberha", labelPos: "below" },
  { x: 555, y: 590, name: "East London" },
  { x: 820, y: 125, name: "Pemba" },
];
---

<section id="map" class="relative bg-base py-24 lg:py-32 overflow-hidden">
  <div class="max-w-7xl mx-auto px-6 lg:px-12">
    <div class="max-w-3xl mb-16 space-y-6">
      <div data-anim="map-eyebrow" class="opacity-0 -translate-y-2">
        <span class="text-xs lg:text-sm font-semibold uppercase tracking-[0.25em] text-gold">
          Footprint
        </span>
      </div>
      <h2
        data-anim="map-headline"
        class="opacity-0 translate-y-4 text-4xl md:text-5xl lg:text-6xl leading-[1.1] text-cream"
      >
        Ten ports.<br />
        <span class="text-gold">Full coverage.</span>
      </h2>
      <p
        data-anim="map-sub"
        class="opacity-0 translate-y-4 text-lg text-mute max-w-2xl"
      >
        From Walvis Bay to Pemba: Afrishore is on the ground across Namibia, South Africa and Mozambique giving full coverage for Sub-Saharan Africa.
      </p>
    </div>

    <!-- Map -->
    <div
      data-anim="map-svg"
      class="opacity-0 relative w-full aspect-[10/7] max-w-5xl mx-auto bg-surface/40 rounded-sm border border-line p-4 md:p-8"
    >
      <svg
        viewBox="0 0 1000 700"
        xmlns="http://www.w3.org/2000/svg"
        role="img"
        aria-label="Afrishore operational footprint across South Africa, Namibia and Mozambique"
        class="w-full h-full"
      >
        <defs>
          <linearGradient id="coastGradient" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#ED7014" />
            <stop offset="100%" stop-color="#FDE64B" />
          </linearGradient>
          <radialGradient id="pinPulse" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color="#ED7014" stop-opacity="0.5" />
            <stop offset="100%" stop-color="#ED7014" stop-opacity="0" />
          </radialGradient>
        </defs>

        <!-- Country labels — warm bronze background type, centred inland of each territory.
             Larger font-size so labels stay legible when the SVG scales down on mobile. -->
        <text x="285" y="260" text-anchor="middle" fill="#8A7551" font-family="Inter, sans-serif" font-size="22" letter-spacing="0.25em" font-weight="700">NAMIBIA</text>
        <text x="450" y="510" text-anchor="middle" fill="#8A7551" font-family="Inter, sans-serif" font-size="22" letter-spacing="0.25em" font-weight="700">SOUTH AFRICA</text>
        <!-- MOZAMBIQUE is a narrow NE–SW wedge; at 22px/0.25em the label
             is wider than the territory and crosses the coast. Smaller
             size + tighter tracking + placed in the widest upper section
             keeps it fully inland. -->
        <text x="690" y="180" text-anchor="middle" fill="#8A7551" font-family="Inter, sans-serif" font-size="15" letter-spacing="0.10em" font-weight="700">MOZAMBIQUE</text>

        <!-- Country borders — thin faint gold dashed lines, geographically accurate.
             5 countries (NA, SA, MZ, Bot, Zim) meeting at 6 tri-points:
             - NA-Bot-Zam (Caprivi) ≈ (360, 100)
             - Bot-Zim-Zam          ≈ (455, 105)
             - Zim-Zam-MZ           ≈ (580, 85)
             - NA-Bot-SA            ≈ (342, 365)
             - Bot-Zim-SA           ≈ (512, 331)
             - SA-Zim-MZ            ≈ (632, 340)
        -->
        <g class="opacity-0" data-borders>
          <!-- NAMIBIA outline (excl Atlantic coast): N (Angola) → E (Bot) → S (Orange River) -->
          <path
            d="M 200 105 L 360 100 L 342 365 Q 290 388, 240 412"
            stroke="#F5AB2F"
            stroke-width="1"
            stroke-opacity="0.4"
            stroke-dasharray="4 4"
            fill="none"
          />

          <!-- SA's inland borders: NA tri → Bot tri → Zim tri → MZ coast (Lebombo) -->
          <path
            d="M 342 365 L 512 331 L 632 340 L 660 441"
            stroke="#F5AB2F"
            stroke-width="1"
            stroke-opacity="0.4"
            stroke-dasharray="4 4"
            fill="none"
          />

          <!-- Botswana-Zimbabwe border -->
          <path
            d="M 455 105 L 512 331"
            stroke="#F5AB2F"
            stroke-width="1"
            stroke-opacity="0.4"
            stroke-dasharray="4 4"
            fill="none"
          />

          <!-- Northern boundary across inland (Angola/Zambia/Tanzania edges):
               NA-Bot tri → Bot-Zim tri → Zim-MZ tri → MZ-Tanzania coast -->
          <path
            d="M 360 100 L 455 105 L 580 85 Q 700 115, 820 115"
            stroke="#F5AB2F"
            stroke-width="1"
            stroke-opacity="0.4"
            stroke-dasharray="4 4"
            fill="none"
          />

          <!-- Zimbabwe-Mozambique border (north tri-point south to SA-Zim-MZ tri-point) -->
          <path
            d="M 580 85 L 632 340"
            stroke="#F5AB2F"
            stroke-width="1"
            stroke-opacity="0.4"
            stroke-dasharray="4 4"
            fill="none"
          />
        </g>

        <!-- Coastline (will animate via stroke-dashoffset, lit by travelling spark) -->
        <path
          id="coastline-path"
          d="M 200 80
             C 220 150, 180 230, 210 290
             C 220 350, 240 390, 240 440
             C 245 480, 270 520, 290 565
             C 295 595, 310 620, 360 615
             C 430 615, 490 610, 540 595
             C 580 575, 615 525, 650 460
             C 680 395, 710 315, 750 235
             C 790 155, 820 115, 850 90"
          stroke="url(#coastGradient)"
          stroke-width="3"
          fill="none"
          stroke-linecap="round"
          pathLength="1"
          stroke-dasharray="1"
          stroke-dashoffset="1"
        />

        <!-- Fuse spark — travels along the coastline as it draws -->
        <circle
          id="coastline-spark"
          cx="200"
          cy="80"
          r="6"
          fill="#FDE64B"
          opacity="0"
          style="filter: drop-shadow(0 0 6px #FDE64B) drop-shadow(0 0 14px #ED7014);"
        />

        <!-- Office pins (orange + pulse halo) -->
        {offices.map((o) => (
          <g class="opacity-0" data-pin="office">
            <circle cx={o.x} cy={o.y} r="22" fill="url(#pinPulse)" />
            <circle cx={o.x} cy={o.y} r={o.isHQ ? 10 : 8} fill="#ED7014" />
            {o.labelPos === "below" ? (
              <text x={o.x} y={o.y + 38} text-anchor="middle" fill="#F5F2EB" font-family="Inter, sans-serif" font-size="18" font-weight="600">
                {o.name}
              </text>
            ) : o.labelPos === "left" ? (
              <text x={o.x - 18} y={o.y + 5} text-anchor="end" fill="#F5F2EB" font-family="Inter, sans-serif" font-size="18" font-weight="600">
                {o.name}
              </text>
            ) : (
              <text x={o.x + 18} y={o.y + 5} fill="#F5F2EB" font-family="Inter, sans-serif" font-size="18" font-weight="600">
                {o.name}
              </text>
            )}
          </g>
        ))}

        <!-- Service port pins (gold, small, dark stroke for visibility against gradient coastline) -->
        {ports.map((p) => (
          <g class="opacity-0" data-pin="port">
            <circle cx={p.x} cy={p.y} r="5" fill="#FDE64B" stroke="#0A0A0A" stroke-width="1" />
            {p.labelPos === "above" ? (
              <text x={p.x} y={p.y - 11} text-anchor="middle" fill="#A39E94" font-family="Inter, sans-serif" font-size="14">{p.name}</text>
            ) : p.labelPos === "below" ? (
              <text x={p.x} y={p.y + 20} text-anchor="middle" fill="#A39E94" font-family="Inter, sans-serif" font-size="14">{p.name}</text>
            ) : (
              <text x={p.x + 10} y={p.y + 4} fill="#A39E94" font-family="Inter, sans-serif" font-size="14">{p.name}</text>
            )}
          </g>
        ))}
      </svg>

      <!-- Legend — overlaid bottom-right on desktop, but lifted below the
           map on mobile where the small viewport would have the chip
           overlap the Durban / East London / Mossel Bay pin cluster. -->
      <div class="hidden md:flex absolute bottom-6 right-6 items-center gap-6 text-xs text-mute bg-base/60 backdrop-blur-sm px-4 py-2 rounded-sm">
        <div class="flex items-center gap-2">
          <span class="w-3 h-3 rounded-full bg-orange"></span>
          <span>Office</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-yellow"></span>
          <span>Service port</span>
        </div>
      </div>
    </div>

    <!-- Mobile-only legend: sits below the map, never overlaps pins -->
    <div class="md:hidden mt-4 flex items-center justify-center gap-6 text-xs text-mute">
      <div class="flex items-center gap-2">
        <span class="w-3 h-3 rounded-full bg-orange"></span>
        <span>Office</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-yellow"></span>
        <span>Service port</span>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  // Section header reveal
  gsap.timeline({
    scrollTrigger: { trigger: "#map", start: "top 75%", toggleActions: "play none none none" },
    defaults: { ease: "power3.out", duration: 0.9 },
  })
    .to("[data-anim='map-eyebrow']", { opacity: 1, y: 0 }, 0)
    .to("[data-anim='map-headline']", { opacity: 1, y: 0, duration: 1.1 }, 0.15)
    .to("[data-anim='map-sub']", { opacity: 1, y: 0 }, 0.4)
    .to("[data-anim='map-svg']", { opacity: 1, duration: 0.8 }, 0.6);

  // Coastline animates like a lit fuse — spark travels from Namibian top
  // to Mozambican top while the stroke draws in behind it.
  ScrollTrigger.create({
    trigger: "#coastline-path",
    start: "top 80%",
    once: true,
    onEnter: () => {
      const path = document.querySelector<SVGPathElement>("#coastline-path");
      const spark = document.querySelector<SVGCircleElement>("#coastline-spark");
      if (!path || !spark) return;

      const total = path.getTotalLength();
      const progress = { p: 0 };

      gsap.set(spark, { opacity: 1 });

      gsap.to(progress, {
        p: 1,
        duration: 1.1,
        ease: "power2.out",
        onUpdate: () => {
          const pt = path.getPointAtLength(total * progress.p);
          spark.setAttribute("cx", String(pt.x));
          spark.setAttribute("cy", String(pt.y));
          path.style.strokeDashoffset = String(1 - progress.p);
        },
        onComplete: () => {
          // Fuse reaches Mozambican end — spark fades out
          gsap.to(spark, { opacity: 0, duration: 0.4, ease: "power2.out" });

          // Borders fade in subtly after coast
          gsap.to("[data-borders]", {
            opacity: 1,
            duration: 0.9,
            ease: "power2.out",
          });
          // Pins drop in with stagger
          gsap.to("[data-pin='office']", {
            opacity: 1,
            duration: 0.5,
            stagger: 0.1,
            delay: 0.15,
            ease: "power3.out",
          });
          gsap.to("[data-pin='port']", {
            opacity: 1,
            duration: 0.4,
            stagger: 0.06,
            delay: 0.4,
            ease: "power2.out",
          });
        },
      });
    },
  });
</script>
