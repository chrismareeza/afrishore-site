---
// Hero — full-bleed cinematic intro
// Background: rig + Table Mountain image with dark vignette
// Content: eyebrow → H1 → subhead → CTAs, anchored bottom-left
// Animation: GSAP-driven fade-up cascade on load + subtle scroll parallax
---

<section class="relative w-full h-[100svh] min-h-[640px] overflow-hidden bg-base">
  <!-- Background image layer (will pan slightly on scroll).
       image-set() lets modern browsers prefer the smaller WebP; the JPEG
       URL stays declared as the fallback (and is referenced as a sibling
       <link rel="preload" as="image"> in <head> so it starts downloading
       before the CSS is parsed → lowers LCP). -->
  <div
    id="hero-bg"
    class="hero-bg-img absolute inset-0 will-change-transform"
    style="
      background-size: cover;
      background-position: center 55%;
      background-color: #0a0a0a;
      transform: scale(1.05);
    "
  ></div>

  <!-- Text-legibility gradient — CONSTANT. Keeps the headline / subhead
       / CTAs readable over the photo; never animated. -->
  <div
    class="absolute inset-0 pointer-events-none"
    style="background: linear-gradient(to top, rgba(10,10,10,0.97) 0%, rgba(10,10,10,0.88) 30%, rgba(10,10,10,0.6) 55%, rgba(10,10,10,0.25) 75%, rgba(10,10,10,0) 90%);"
  ></div>

  <!-- Ambient scene tint (radial vignette). Starts at full strength,
       then lifts ~50% after the headline ("sunrise") — see hero script. -->
  <div
    id="hero-tint"
    class="absolute inset-0 pointer-events-none"
    style="background: radial-gradient(ellipse at center, transparent 20%, rgba(10,10,10,0.7) 100%);"
  ></div>

  <!-- Foreground "shadow lift" — a second darkness layer focused on
       the lower-left where the rig sits silhouetted against the bay.
       The photograph has the rig in directional shadow (sun is behind
       Table Mountain at this hour) so the existing radial vignette
       alone only lifts ~half the perceived darkness there. This
       targeted ellipse stacks additional darkness over the rig at
       rest, then fades to 0 in sync with #hero-tint — the rig "wakes
       up" in the same beat as the skyline. -->
  <div
    id="hero-tint-foreground"
    class="absolute inset-0 pointer-events-none"
    style="background: radial-gradient(ellipse 38% 45% at 15% 78%, rgba(10,10,10,0.55) 0%, rgba(10,10,10,0.32) 45%, transparent 85%);"
  ></div>

  <!-- Subtle film grain (low opacity) — adds texture, hides JPEG banding -->
  <div
    class="absolute inset-0 pointer-events-none opacity-[0.04] mix-blend-overlay"
    style="
      background-image: url('data:image/svg+xml;utf8,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%22200%22 height=%22200%22><filter id=%22n%22><feTurbulence type=%22fractalNoise%22 baseFrequency=%220.9%22 numOctaves=%221%22/></filter><rect width=%22200%22 height=%22200%22 filter=%22url(%23n)%22/></svg>');
    "
  ></div>

  <!-- Content stack — anchored bottom-left -->
  <div class="relative z-10 h-full max-w-7xl mx-auto px-6 lg:px-12 flex flex-col justify-end pb-24 lg:pb-32">
    <div class="max-w-3xl space-y-7">
      <!-- Eyebrow -->
      <div data-anim="hero-eyebrow" class="opacity-0 -translate-y-2">
        <span class="text-xs lg:text-sm font-semibold uppercase tracking-[0.25em] text-gold">
          Maritime Logistics · Since 2010
        </span>
      </div>

      <!-- H1 — Barlow + per-line gradient + per-word BlurText reveal.
           Mobile cap at text-5xl so 'Local Solutions.' / 'Global Clients.'
           fit cleanly on 375px viewports without horizontal overflow. -->
      <h1 class="hero-title text-5xl sm:text-6xl md:text-7xl lg:text-[5.5rem]">
        <span class="block line" data-blurtext="Local Solutions." data-delay="100">Local Solutions.</span>
        <span class="block line" data-blurtext="Global Clients." data-delay="700">Global Clients.</span>
      </h1>

      <!-- Subhead — high contrast against bright imagery. Hard-line-
           broken via <span class="block"> at desktop reading widths so
           the four-line cadence matches the H1's two-line cadence
           (Local Solutions. / Global Clients. → 4 subhead lines).
           Mobile collapses to natural-wrap within each block. -->
      <p
        data-anim="hero-subhead"
        class="opacity-0 translate-y-4 text-lg lg:text-xl max-w-2xl leading-relaxed"
        style="color: rgba(245,242,235,0.92); text-shadow: 0 1px 6px rgba(0,0,0,0.4);"
      >
        <span class="lg:block">Logistics agency to leading oil &amp; gas operators,</span>
        <span class="lg:block">drilling contractors and rig and vessel owners since 2010.</span>
        <span class="lg:block">Integrated offshore supply base operations across</span>
        <span class="lg:block">South Africa, Namibia and Mozambique.</span>
      </p>

      <!-- CTAs — min-h-[48px] keeps tap targets comfortable on touch devices -->
      <div data-anim="hero-ctas" class="opacity-0 translate-y-4 flex flex-col sm:flex-row sm:flex-wrap sm:items-center gap-3 sm:gap-4 pt-2">
        <a
          href="#contact"
          class="inline-flex items-center justify-center sm:justify-start gap-2 bg-orange hover:bg-gold text-base px-7 py-4 text-base font-semibold tracking-wide transition-all duration-200 rounded-sm min-h-[48px]"
        >
          Contact Us
          <span aria-hidden="true">→</span>
        </a>
        <a
          href="#services"
          class="inline-flex items-center justify-center sm:justify-start gap-2 border border-cream/30 hover:border-cream/60 hover:bg-cream/5 text-cream px-7 py-4 text-base font-semibold tracking-wide transition-all duration-200 rounded-sm min-h-[48px]"
        >
          Our Capabilities
        </a>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div
    data-anim="hero-scroll"
    class="absolute bottom-8 right-8 lg:right-12 opacity-0 z-10 flex items-center gap-3 text-faint"
  >
    <span class="text-xs uppercase tracking-[0.2em] hidden md:inline">Scroll to explore</span>
    <span class="block w-px h-12 bg-faint/40 relative overflow-hidden">
      <span
        class="absolute top-0 left-0 w-full h-1/2 bg-gold animate-[scrollLine_2s_ease-in-out_infinite]"
      ></span>
    </span>
  </div>
</section>

<style>
  @keyframes scrollLine {
    0%   { transform: translateY(-100%); }
    50%  { transform: translateY(50%); }
    100% { transform: translateY(200%); }
  }

  /* Responsive hero background — identical crop, lower-res on phones.
     Desktop: 1920w; ≤768px viewport: 1280w (~half the bytes, LCP win).
     image-set() prefers WebP with a JPEG fallback. */
  .hero-bg-img {
    background-image: url('/images/hero-cape-town.jpg');
    background-image: image-set(
      url('/images/hero-cape-town.webp') type('image/webp'),
      url('/images/hero-cape-town.jpg') type('image/jpeg')
    );
  }
  @media (max-width: 768px) {
    .hero-bg-img {
      background-image: url('/images/hero-cape-town-1280.jpg');
      background-image: image-set(
        url('/images/hero-cape-town-1280.webp') type('image/webp'),
        url('/images/hero-cape-town-1280.jpg') type('image/jpeg')
      );
    }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  // ── Entrance animation cascade ──
  const tl = gsap.timeline({
    defaults: { ease: "power3.out", duration: 1.0 },
  });

  tl.to("#hero-bg", { scale: 1.0, duration: 1.8, ease: "power2.out" }, 0)
    .to("[data-anim='hero-eyebrow']", { opacity: 1, y: 0 }, 0.3)
    .to("[data-anim='hero-subhead']", { opacity: 1, y: 0 }, 1.1)
    .to("[data-anim='hero-ctas']", { opacity: 1, y: 0 }, 1.3)
    .to("[data-anim='hero-scroll']", { opacity: 1, duration: 0.8 }, 1.5);

  // ── Scroll parallax ──
  // Background moves slower than content as user scrolls
  gsap.to("#hero-bg", {
    yPercent: 25,
    ease: "none",
    scrollTrigger: {
      trigger: "section",
      start: "top top",
      end: "bottom top",
      scrub: true,
    },
  });

  // ── BlurText word-by-word reveal (per Claude Design spec) ──
  (function () {
    const STEP_DURATION = 350;
    const STEPS = [
      { filter: "blur(10px)", opacity: "0",   transform: "translateY(50px)" },
      { filter: "blur(5px)",  opacity: "0.5", transform: "translateY(-5px)" },
      { filter: "blur(0px)",  opacity: "1",   transform: "translateY(0)" },
    ];

    function applyStep(span: HTMLElement, step: typeof STEPS[0]) {
      span.style.filter = step.filter;
      span.style.opacity = step.opacity;
      span.style.transform = step.transform;
    }

    function initLine(line: HTMLElement, lineDelay: number) {
      const text = line.dataset.blurtext || line.textContent || "";
      const wordDelay = parseInt(line.dataset.delay || "100", 10);
      const words = text.split(/\s+/).filter(Boolean);

      line.textContent = "";
      const wordSpans: HTMLElement[] = [];

      words.forEach((word, i) => {
        const span = document.createElement("span");
        span.className = "blur-word";
        span.textContent = word;
        applyStep(span, STEPS[0]);
        span.style.transition =
          `filter ${STEP_DURATION}ms ease, opacity ${STEP_DURATION}ms ease, transform ${STEP_DURATION}ms ease`;
        line.appendChild(span);
        wordSpans.push(span);
        if (i < words.length - 1) line.appendChild(document.createTextNode(" "));
      });

      // Measure for continuous gradient across words
      requestAnimationFrame(() => {
        const lineRect = line.getBoundingClientRect();
        wordSpans.forEach((span) => {
          const wr = span.getBoundingClientRect();
          span.style.setProperty("--line-w", `${lineRect.width}px`);
          span.style.setProperty("--word-x", `${-(wr.left - lineRect.left)}px`);
        });

        // Animate each word: STEP 0 → 1 → 2 staggered
        wordSpans.forEach((span, i) => {
          const base = lineDelay + i * wordDelay;
          setTimeout(() => {
            applyStep(span, STEPS[1]);
            setTimeout(() => applyStep(span, STEPS[2]), STEP_DURATION);
          }, base);
        });
      });
    }

    function start() {
      const lines = document.querySelectorAll<HTMLElement>(".hero-title [data-blurtext]");
      // Line 0 ("Local Solutions.") reveals first, unchanged. Line 1
      // ("Global Clients.") only begins once line 0 has fully resolved
      // (~2×STEP + last-word offset ≈ 800ms) so it reads as a distinct
      // second beat — and its data-delay="700" then sequences "Clients"
      // to appear only after "Global" has finished.
      const lineStart = [0, 950];
      lines.forEach((line, i) => {
        initLine(line, lineStart[i] ?? i * 950);
      });
    }

    // Run after the GSAP cascade hits the headline position (~600ms)
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", () => setTimeout(start, 600));
    } else {
      setTimeout(start, 600);
    }
  })();

  // ── "Sunrise" ──────────────────────────────────────────────────────
  // After "Global Clients." resolves, the scene visibly brightens like
  // dawn: the ambient vignette opens fully (#hero-tint → 0) AND the
  // photo itself lifts (#hero-bg brightness 1 → 1.18). The constant
  // text-legibility gradient sits above the photo and is untouched, so
  // the headline / CTAs stay readable. Tunable: brightness target +
  // tint end-opacity = intensity; SUNRISE_DELAY = when; duration = pace.
  // Timing (from ready): start() @ +600 · line-1 @ +950 · "Clients."
  // base = 950 + 700 = 1650 · +STEP_DURATION×2 (700) ≈ ~2350 → ~2950
  // absolute; +~300ms breath = 3250 → pulled 1s earlier = 2250.
  (function () {
    const SUNRISE_DELAY = 2250;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      // Motion-sensitive users: present the brightened end-state from
      // the start — no delayed jump, no animation.
      gsap.set("#hero-tint", { opacity: 0 });
      gsap.set("#hero-tint-foreground", { opacity: 0 });
      gsap.set("#hero-bg", { filter: "brightness(1.18)" });
      return;
    }
    const sunrise = () => {
      gsap.to("#hero-tint", { opacity: 0, duration: 2.6, ease: "power2.inOut" });
      // Foreground shadow over the rig lifts on the same beat as the
      // skyline vignette — same duration/ease so both feel like one
      // dawn moment, not two separate fades.
      gsap.to("#hero-tint-foreground", { opacity: 0, duration: 2.6, ease: "power2.inOut" });
      gsap.fromTo(
        "#hero-bg",
        { filter: "brightness(1)" },
        { filter: "brightness(1.18)", duration: 2.6, ease: "power2.inOut" }
      );
    };
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", () =>
        setTimeout(sunrise, SUNRISE_DELAY)
      );
    } else {
      setTimeout(sunrise, SUNRISE_DELAY);
    }
  })();
</script>
