---
// Section · Built local. Built to standard.
// Five operating-standard pillars: 3-card top row + 2-card bottom row.
// Live on the homepage, replacing the former Timeline section.

// ── Pillar 4 · localisation line-graph data ───────────────────────────
// Namibian workforce content over time. Two anchor points confirmed
// (2022 = 50%, 2026 = 91%); intermediate years can be added here later
// and the SVG line extends automatically.
const localisation = [
  { year: 2022, pct: 50 },
  { year: 2026, pct: 91 },
];
const Y_MIN = 2022, Y_MAX = 2026, P_MIN = 40, P_MAX = 100;
const GX0 = 40, GX1 = 306, GY0 = 20, GY1 = 104;
const sx = (yr: number) => GX0 + ((yr - Y_MIN) / (Y_MAX - Y_MIN)) * (GX1 - GX0);
const sy = (p: number) => GY1 - ((p - P_MIN) / (P_MAX - P_MIN)) * (GY1 - GY0);
const linePts = localisation.map((d) => `${sx(d.year).toFixed(1)},${sy(d.pct).toFixed(1)}`).join(" ");
const axisYears = [2022, 2023, 2024, 2025, 2026];
const firstPt = localisation[0];
const lastPt = localisation[localisation.length - 1];
const deltaPct = lastPt.pct - firstPt.pct;

// ── Pillar 5 · carbon widget data (from GHG_Emissions_DMI_May_2026) ────
const carbonTotalT = 4.088;
const carbonBars = [
  { label: "Cranes", t: 1.70 },
  { label: "Forklifts", t: 1.79 },
  { label: "Trucks", t: 0.60 },
].map((b) => ({ ...b, pct: (b.t / carbonTotalT) * 100 }));

// ── Pillar 3 · HSE live LTI-free-day counter ──────────────────────────
// 869 lost-time-injury-free days as of 2026-05-21. The figure advances
// daily: baked at build time, recomputed client-side on load so a stale
// build self-corrects. RESET if an LTI occurs — update the two consts
// here AND the matching constants in the <script> below.
const LTI_REF_ISO = "2026-05-21";
const LTI_REF_DAYS = 869;
const ltiDaysNow =
  LTI_REF_DAYS + Math.max(0, Math.floor((Date.now() - Date.parse(LTI_REF_ISO)) / 86400000));

// Manhours worked on base, year to date — modelled at 1,553 hrs/month
// (calendar-month number × 1,553), so it steps up on the 1st of each
// month and resets to January's 1,553 at the start of every year.
// Baked at build time, recomputed client-side on load.
const MANHOURS_PER_MONTH = 1553;
const manhoursNow = (new Date().getMonth() + 1) * MANHOURS_PER_MONTH;

// ── Pillar definitions ────────────────────────────────────────────────
// span: 2 = top-row third (3×2 = 6 cols); 3 = bottom-row half (2×3 = 6).
// chip values containing "{" are pending figures.
const pillars = [
  {
    n: 1,
    kind: "facilities" as const,
    span: 2,
    label: "The team",
    claim: "Specialists meeting your outcomes in port, on quayside and within your project.",
    chip: "",
    boxTitle: "Afrishore Team",
    boxSub: "Across South Africa & Namibia",
    image: "/images/built-local/team.jpg" as string | null,
    imageAlt:
      "The Afrishore team in PPE on the quayside at the Walvis Bay supply base, working a rig mooring-anchor spread",
  },
  {
    n: 2,
    kind: "facilities" as const,
    span: 2,
    label: "Yards & equipment",
    claim: "Bonded laydown ready. Cranage, forklifts and trucks on duty for every campaign.",
    chip: "",
    boxTitle: "Afrishore Facilities",
    boxSub: "Walvis Bay Logistics Base",
    image: "/images/built-local/yards-crane.jpg" as string | null,
    imageAlt:
      "Crane and rigging spread handling rig tubulars on the quay at the Afrishore Walvis Bay supply base",
  },
  {
    n: 3,
    kind: "hse" as const,
    span: 2,
    label: "HSE record",
    claim: "Hours worked, lessons learned, incidents avoided, counted and audited.",
    chip: "",
  },
  {
    n: 4,
    kind: "national" as const,
    span: 3,
    label: "National content & skills transfer",
    claim:
      "Skills-transfer programmes, national-content alignment and active PDP development across both territories.",
    chip: "B-BBEE Level 1 · 91% Namibian workforce content",
  },
  {
    n: 5,
    kind: "carbon" as const,
    span: 3,
    label: "Carbon, tracked",
    claim:
      "Every call measured. Every project reported. Via the Afrishore Logistics app.",
    chip: "100% carbon-tracked since January 2024",
  },
];

const isPending = (s: string) => s.includes("{");
---

<section id="built-local" class="relative bg-base py-24 lg:py-32 overflow-hidden">
  <div class="max-w-7xl mx-auto px-6 lg:px-12">
    <!-- Section header -->
    <div class="max-w-3xl mb-16 lg:mb-20 space-y-6">
      <div data-anim="bl-eyebrow" class="opacity-0 -translate-y-2">
        <span class="text-xs lg:text-sm font-semibold uppercase tracking-[0.25em] text-gold">
          How we operate
        </span>
      </div>
      <h2
        data-anim="bl-headline"
        class="opacity-0 translate-y-4 text-4xl md:text-5xl lg:text-6xl leading-[1.1] text-cream"
      >
        Built local.<br />
        <span class="text-gold">Built to standard.</span>
      </h2>
      <p
        data-anim="bl-sub"
        class="opacity-0 translate-y-4 text-lg text-mute max-w-2xl"
      >
        The data tells us what. Our people tell us how.
      </p>
    </div>

    <!-- 5-card grid · 3 top / 2 bottom -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-6 gap-6 lg:gap-8">
      {pillars.map((p) => (
        <article
          data-anim="bl-card"
          class:list={[
            "opacity-0 translate-y-8 group relative bg-surface border border-line hover:border-gold/40 transition-all duration-500 rounded-sm overflow-hidden flex flex-col",
            p.span === 3 ? "lg:col-span-3" : "lg:col-span-2",
            // Tablet (2-col): Carbon is the 5th card, so it spans the full
            // row rather than orphaning half-width beside an empty column.
            p.kind === "carbon" && "md:col-span-2",
          ]}
        >
          {/* ── Visual area ─────────────────────────────────────── */}
          {p.kind === "facilities" && (
            <div class="p-5 lg:p-6 flex-1 flex flex-col">
              <div class="bg-base border border-line rounded-sm p-5 space-y-4 flex-1 flex flex-col">
                <div>
                  <p class="text-[0.65rem] uppercase tracking-[0.18em] text-gold font-semibold">
                    {p.boxTitle}
                  </p>
                  <p class="text-xs text-faint mt-0.5">{p.boxSub}</p>
                </div>
                <div class="flex-1 min-h-[10rem] overflow-hidden rounded-sm">
                  <img
                    src={p.image}
                    alt={p.imageAlt}
                    class="w-full h-full object-cover"
                    loading="lazy"
                    decoding="async"
                    width="1400"
                    height="1050"
                  />
                </div>
              </div>
            </div>
          )}

          {p.kind === "hse" && (
            <div class="p-5 lg:p-6 flex-1 flex flex-col">
              <div class="bg-base border border-line rounded-sm p-5 space-y-4 flex-1 flex flex-col">
                <div>
                  <p class="text-[0.65rem] uppercase tracking-[0.18em] text-gold font-semibold">
                    Afrishore HSE Data
                  </p>
                  <p class="text-xs text-faint mt-0.5">Walvis Bay Logistics Base</p>
                </div>
                <div class="space-y-4 flex-1 flex flex-col justify-center">
                  <div>
                    <p class="font-display text-4xl lg:text-5xl text-yellow leading-none">
                      <span data-lti-counter>{ltiDaysNow.toLocaleString()}</span>
                    </p>
                    <p class="text-xs text-mute mt-1.5 leading-snug">days lost-time-injury-free</p>
                  </div>
                  <div class="border-t border-line pt-4">
                    <p class="font-display text-4xl lg:text-5xl text-yellow leading-none">
                      <span data-manhours-counter>{manhoursNow.toLocaleString()}</span>
                    </p>
                    <p class="text-xs text-mute mt-1.5 leading-snug">manhours, year to date</p>
                  </div>
                </div>
              </div>
            </div>
          )}

          {p.kind === "national" && (
            <div class="p-5 lg:p-6 flex-1 flex flex-col">
              <div class="bg-base border border-line rounded-sm p-5 space-y-5 flex-1 flex flex-col">
                <div>
                  <p class="text-[0.65rem] uppercase tracking-[0.18em] text-gold font-semibold">
                    Afrishore · National Content
                  </p>
                  <p class="text-xs text-faint mt-0.5">South Africa &amp; Namibia · 2026</p>
                </div>

                <div class="grid grid-cols-2 gap-4">
                  <div class="space-y-1">
                    <p class="text-[0.6rem] uppercase tracking-[0.14em] text-faint">South Africa</p>
                    <p class="font-display text-3xl lg:text-4xl text-yellow leading-none">Level 1</p>
                    <p class="text-xs text-mute leading-snug">B-BBEE</p>
                  </div>
                  <div class="space-y-1">
                    <p class="text-[0.6rem] uppercase tracking-[0.14em] text-faint">Namibia</p>
                    <p class="font-display text-3xl lg:text-4xl text-yellow leading-none">51%</p>
                    <p class="text-xs text-mute leading-snug">Namibian-owned · 34% PDP-owned</p>
                  </div>
                </div>

                <div class="space-y-2">
                  <p class="text-[0.65rem] uppercase tracking-[0.18em] text-faint">
                    Namibian workforce content, 2022 → 2026
                  </p>
                  <svg viewBox="0 0 340 132" class="w-full h-auto" role="img"
                    aria-label={`Namibian workforce content rose from ${firstPt.pct}% in ${firstPt.year} to ${lastPt.pct}% in ${lastPt.year}.`}>
                    <defs>
                      <linearGradient id="bl-line" x1="0" y1="0" x2="1" y2="0">
                        <stop offset="0%" stop-color="#ED7014" />
                        <stop offset="100%" stop-color="#FDE64B" />
                      </linearGradient>
                    </defs>
                    {/* reference gridlines + axis labels at 50% and 100% */}
                    <line x1={GX0} y1={sy(50)} x2={GX1} y2={sy(50)} stroke="#1F1F1F" stroke-width="1" />
                    <line x1={GX0} y1={sy(100)} x2={GX1} y2={sy(100)} stroke="#1F1F1F" stroke-width="1" />
                    <text x={GX0 - 6} y={sy(50) + 3} text-anchor="end" font-size="9" fill="#8C8980">50%</text>
                    <text x={GX0 - 6} y={sy(100) + 3} text-anchor="end" font-size="9" fill="#8C8980">100%</text>
                    {/* trajectory — draws itself in on scroll (see <script>) */}
                    <polyline id="bl-natline" points={linePts} fill="none" stroke="url(#bl-line)"
                      stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"
                      pathLength="1" stroke-dasharray="1" stroke-dashoffset="1" />
                    {/* data points + 91% label — fade in once the line is drawn */}
                    <g data-bl-natpts style="opacity:0">
                      {localisation.map((d) => (
                        <circle cx={sx(d.year)} cy={sy(d.pct)} r="4" fill="#FDE64B" stroke="#0A0A0A" stroke-width="1.5" />
                      ))}
                      <text x={sx(lastPt.year)} y={sy(lastPt.pct) - 9} text-anchor="end"
                        font-size="12" font-weight="700" fill="#F5F2EB">{lastPt.pct}%</text>
                    </g>
                    {/* year axis */}
                    {axisYears.map((yr) => (
                      <text x={sx(yr)} y="124" text-anchor="middle" font-size="9" fill="#8C8980">
                        {yr === 2022 || yr === 2026 ? yr : `'${String(yr).slice(2)}`}
                      </text>
                    ))}
                  </svg>
                  <p class="text-[0.7rem] text-faint leading-relaxed border-t border-line pt-3">
                    +{deltaPct} percentage points since {firstPt.year}.
                  </p>
                </div>
              </div>
            </div>
          )}

          {p.kind === "carbon" && (
            <div class="p-5 lg:p-6 flex-1 flex flex-col">
              <div class="bg-base border border-line rounded-sm p-5 space-y-4 flex-1 flex flex-col">
                <div>
                  <p class="text-[0.65rem] uppercase tracking-[0.18em] text-gold font-semibold">
                    Afrishore Logistics · GHG Report
                  </p>
                  <p class="text-xs text-faint mt-0.5">May 2026 · WVB Offshore Supply Base</p>
                </div>

                <div>
                  <p class="font-display text-5xl lg:text-6xl text-yellow leading-none">
                    {carbonTotalT.toFixed(3)}<span class="text-2xl lg:text-3xl"> t</span>
                  </p>
                  <p class="text-xs text-mute mt-1.5">CO₂e for the month</p>
                </div>

                <p class="text-sm text-cream/80">103 hrs · 4,087 kg CO₂</p>

                <div class="space-y-2">
                  <p class="text-[0.65rem] uppercase tracking-[0.18em] text-faint">Where it came from</p>
                  {carbonBars.map((b) => (
                    <div class="flex items-center gap-3 text-xs">
                      <span class="w-14 shrink-0 text-mute">{b.label}</span>
                      <span class="flex-1 h-2 bg-line rounded-full overflow-hidden">
                        <span
                          class="block h-full rounded-full"
                          data-bl-bar
                          data-pct={b.pct.toFixed(1)}
                          style="width:0%; background:linear-gradient(90deg,#ED7014,#FDE64B);"
                        ></span>
                      </span>
                      <span class="w-12 text-right text-cream tabular-nums">{b.t.toFixed(2)} t</span>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          )}

          {/* ── Card body ───────────────────────────────────────── */}
          <div class:list={["p-6 lg:p-7 pt-5 flex flex-col gap-3", p.span === 3 ? "lg:min-h-[11rem]" : "lg:min-h-[9.5rem]"]}>
            <span class="text-xs uppercase tracking-[0.18em] text-gold font-semibold">
              {p.label}
            </span>
            <p class="text-base lg:text-lg text-cream leading-snug">
              {p.claim}
            </p>
            {p.kind !== "hse" && p.chip && (
              <span
                class:list={[
                  "mt-auto pt-3 inline-flex items-center gap-2 text-xs leading-snug",
                  isPending(p.chip) ? "text-faint italic" : "text-mute",
                ]}
              >
                <span
                  class="w-1.5 h-1.5 rounded-full shrink-0"
                  style={isPending(p.chip)
                    ? "background:#8C8980;"
                    : "background:linear-gradient(135deg,#ED7014,#FDE64B);"}
                  aria-hidden="true"
                ></span>
                {p.chip}
              </span>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  // HSE · LTI-free-day counter — recompute on load so a stale build
  // self-corrects. Keep these two in sync with the frontmatter consts.
  // RESET both (date + days) if a lost-time injury occurs.
  const LTI_REF = Date.parse("2026-05-21");
  const LTI_REF_DAYS = 869;
  const ltiDays = LTI_REF_DAYS + Math.max(0, Math.floor((Date.now() - LTI_REF) / 86400000));
  document.querySelectorAll("[data-lti-counter]").forEach((el) => {
    el.textContent = ltiDays.toLocaleString();
  });

  // HSE · manhours counter — modelled at 1,553 hrs/month (calendar-month
  // number × 1,553); steps up on the 1st of each month, resets each
  // January. Recomputed on load.
  const manhoursVal = (new Date().getMonth() + 1) * 1553;
  document.querySelectorAll("[data-manhours-counter]").forEach((el) => {
    el.textContent = manhoursVal.toLocaleString();
  });

  // Section header reveal
  gsap.timeline({
    scrollTrigger: {
      trigger: "#built-local",
      start: "top 75%",
      toggleActions: "play none none none",
    },
    defaults: { ease: "power3.out", duration: 0.9 },
  })
    .to("[data-anim='bl-eyebrow']", { opacity: 1, y: 0 }, 0)
    .to("[data-anim='bl-headline']", { opacity: 1, y: 0, duration: 1.1 }, 0.15)
    .to("[data-anim='bl-sub']", { opacity: 1, y: 0 }, 0.4);

  // Staggered card reveal
  gsap.to("[data-anim='bl-card']", {
    opacity: 1,
    y: 0,
    duration: 0.9,
    stagger: 0.1,
    ease: "power3.out",
    scrollTrigger: {
      trigger: "[data-anim='bl-card']",
      start: "top 82%",
      toggleActions: "play none none none",
    },
  });

  // ── Data-viz reveals · National Content line + Carbon bars ──────────
  // Same scroll-triggered style as the footprint map: each graph plays
  // once as it scrolls into view — the trajectory line draws itself in,
  // the emission bars fill from zero.
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const natLine = document.querySelector<SVGPolylineElement>("#bl-natline");
  const natPts = document.querySelector<SVGGElement>("[data-bl-natpts]");
  const carbonBarEls = gsap.utils.toArray<HTMLElement>("[data-bl-bar]");

  if (reduceMotion) {
    // Honour the OS preference — show the final state with no motion.
    if (natLine) natLine.style.strokeDashoffset = "0";
    if (natPts) natPts.style.opacity = "1";
    carbonBarEls.forEach((b) => { b.style.width = (b.dataset.pct ?? "0") + "%"; });
  } else {
    if (natLine && natPts) {
      ScrollTrigger.create({
        trigger: natLine.closest("article"),
        start: "top 78%",
        once: true,
        onEnter: () => {
          gsap.to(natLine, { strokeDashoffset: 0, duration: 1.2, ease: "power2.out" });
          gsap.to(natPts, { opacity: 1, duration: 0.5, delay: 0.75, ease: "power2.out" });
        },
      });
    }
    if (carbonBarEls.length) {
      ScrollTrigger.create({
        trigger: carbonBarEls[0].closest("article"),
        start: "top 78%",
        once: true,
        onEnter: () => {
          carbonBarEls.forEach((bar, i) => {
            gsap.to(bar, {
              width: (bar.dataset.pct ?? "0") + "%",
              duration: 1,
              delay: 0.15 + i * 0.12,
              ease: "power2.out",
            });
          });
        },
      });
    }
  }
</script>
